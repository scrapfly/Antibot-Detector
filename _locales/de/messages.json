  "helpJsHooksTitle": {
    "message": "Erkennung über JavaScript-Hooks"
  },
  "helpJsHooksDescription": {
    "message": "Hooks fangen Browser-API-Aufrufe ab (Canvas, Audio, WebGL usw.), um Anti-Bot-Fingerprinting-Code in Echtzeit zu erkennen, sobald die Seite auf diese APIs zugreift."
  },
  "helpJsHooksWarning": {
    "message": "Hooks müssen bei document_start installiert werden, bevor ein Seitenskript ausgeführt wird – andernfalls kann die Seite Referenzen auf die ursprünglichen APIs speichern, bevor unser Shim aktiv ist."
  },
  "helpJsHooksTip": {
    "message": "Fügen Sie ein Ziel wie CanvasRenderingContext2D.prototype.getImageData hinzu, um Canvas-Fingerprinting zu erkennen."
  },
  "helpWindowTitle": {
    "message": "Erkennung über Window-Eigenschaften"
  },
  "helpWindowDescription": {
    "message": "Erkennt JavaScript-Objekte und -Eigenschaften, die von Anti-Bot-Skripten zum globalen Window-Objekt hinzugefügt werden."
  },
  "helpWindowWarning": {
    "message": "Einige Anti-Bot-Skripte verwenden Symbol()-Schlüssel, die nicht aufzählbar sind – diese sind schwerer zu erkennen."
  },
  "helpWindowTip": {
    "message": "Verwenden Sie Bedingungen wie typeof object oder exists, um den Eigenschaftstyp abzugleichen."
  },
  "helpUrlTitle": {
    "message": "Erkennung über URL-Muster"
  },
  "helpUrlDescription": {
    "message": "Gleicht URLs geladener Ressourcen (Skripte, Bilder, Netzwerkanfragen) mit Mustern ab."
  },
  "helpUrlWarning": {
    "message": "Bei Mustern wird standardmäßig die Groß-/Kleinschreibung beachtet. Schalten Sie die Option \"URL Groß-/Kleinschreibung beachten\" um, wenn Sie einen Abgleich ohne Beachtung der Groß-/Kleinschreibung benötigen."
  },
  "helpUrlTip": {
    "message": "Verwenden Sie die Regex-Option für komplexe Muster wie /\\/v\\d+\\/challenge/."
  },
  "helpHeaderTitle": {
    "message": "Erkennung über HTTP-Header"
  },
  "helpHeaderDescription": {
    "message": "Erkennt HTTP-Request- und -Response-Header, die von Anti-Bot-Middleware gesetzt werden."
  },
  "helpHeaderWarning": {
    "message": "Einige Header sind nur in der ursprünglichen Anfrage vorhanden – stellen Sie sicher, dass Ihr Bereich \"Anfrage\" einschließt."
  },
  "helpHeaderTip": {
    "message": "Häufige Ziele: x-akamai-bot-manager-token, cf-ray, x-shape-version."
  },
  "helpCookieTitle": {
    "message": "Erkennung über Cookies"
  },
  "helpCookieDescription": {
    "message": "Erkennt Cookies, die von Anti-Bot-Challenges gesetzt werden. Gleicht den Cookie-Namen (und optional das Wertmuster) ab."
  },
  "helpCookieWarning": {
    "message": "Cookie-Namen mit zufälligen Suffixen (z. B. _abck-xyz123) erfordern ein Regex-Muster anstelle eines wörtlichen Namens."
  },
  "helpCookieTip": {
    "message": "Verwenden Sie \"Ganzes Wort\" für exakte Namensübereinstimmungen oder \"Regex\" für Präfixmuster wie ^datadome-."
  },
  "helpContentTitle": {
    "message": "Erkennung über Seiteninhalte"
  },
  "helpContentDescription": {
    "message": "Sucht nach Textmustern im HTML der Seite und in Inline-Skript-Tags."
  },
  "helpContentWarning": {
    "message": "Das Scannen der gesamten Seite kann bei großen Seiten langsam sein. Beschränken Sie es auf \"Nur Skripte prüfen\", wenn die Signatur im JS-Code liegt."
  },
  "helpContentTip": {
    "message": "Verwenden Sie \"Ganzes Wort\", um Fehlalarme durch Teilzeichenfolgen innerhalb längerer Wörter zu vermeiden."
  },
  "helpDomTitle": {
    "message": "Erkennung über DOM-Selektoren"
  },
  "helpDomDescription": {
    "message": "Erkennt HTML-Elemente über CSS-Selektoren. Wird ausgelöst, wenn das übereinstimmende Element im DOM vorhanden ist."
  },
  "helpDomWarning": {
    "message": "Selektoren stimmen nur mit Elementen überein, die in das tatsächliche DOM gerendert wurden – nicht mit solchen innerhalb von iframes oder Shadow Roots."
  },
  "helpDomTip": {
    "message": "Verwenden Sie spezifische Selektoren wie div#cf-challenge[data-ray] anstelle von generischen, um Fehlalarme zu reduzieren."
  },
  "helpPayloadTitle": {
    "message": "Erkennung über Anfrage-Nutzlast"
  },
  "helpPayloadDescription": {
    "message": "Überwacht alle HTTP-POST/PUT/PATCH-Anfrage-Bodies auf Textmuster."
  },
  "helpPayloadWarning": {
    "message": "Die Nutzlast-Überwachung funktioniert nur für Anfragen, die unsere Erweiterung abfangen kann (keine verschlüsselten Bodies, keine undurchsichtigen Blobs)."
  },
  "helpPayloadTip": {
    "message": "Kombinieren Sie dies mit einem URL-Muster, um den Abgleich auf bestimmte Endpunkte zu beschränken."
  },
