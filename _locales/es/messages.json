  "helpJsHooksTitle": {
    "message": "Detección por ganchos JavaScript"
  },
  "helpJsHooksDescription": {
    "message": "Los ganchos interceptan llamadas a la API del navegador (Canvas, Audio, WebGL, etc.) para detectar código de fingerprinting antibot en tiempo real cuando la página accede a esas APIs."
  },
  "helpJsHooksWarning": {
    "message": "Los ganchos deben instalarse en document_start antes de que se ejecute cualquier script de la página — de lo contrario la página puede guardar referencias a las APIs originales antes de que nuestro shim esté listo."
  },
  "helpJsHooksTip": {
    "message": "Añade un objetivo como CanvasRenderingContext2D.prototype.getImageData para detectar fingerprinting de canvas."
  },
  "helpWindowTitle": {
    "message": "Detección por propiedades de window"
  },
  "helpWindowDescription": {
    "message": "Detecta objetos y propiedades JavaScript añadidos al global window por scripts antibot."
  },
  "helpWindowWarning": {
    "message": "Algunos scripts antibot usan claves Symbol() que no son enumerables — esas son más difíciles de detectar."
  },
  "helpWindowTip": {
    "message": "Usa condiciones como typeof object o exists para coincidir con el tipo de propiedad."
  },
  "helpUrlTitle": {
    "message": "Detección por patrón de URL"
  },
  "helpUrlDescription": {
    "message": "Coincide URLs de recursos cargados (scripts, imágenes, peticiones de red) con patrones."
  },
  "helpUrlWarning": {
    "message": "Los patrones distinguen mayúsculas por defecto. Activa la opción URL distingue mayúsculas si necesitas coincidencia insensible."
  },
  "helpUrlTip": {
    "message": "Usa la opción Regex para patrones avanzados como /\\/v\\d+\\/challenge/."
  },
  "helpHeaderTitle": {
    "message": "Detección por cabecera HTTP"
  },
  "helpHeaderDescription": {
    "message": "Detecta cabeceras de petición y respuesta HTTP establecidas por middleware antibot."
  },
  "helpHeaderWarning": {
    "message": "Algunas cabeceras solo están en la petición inicial — asegúrate de que tu ámbito incluya Petición."
  },
  "helpHeaderTip": {
    "message": "Objetivos comunes: x-akamai-bot-manager-token, cf-ray, x-shape-version."
  },
  "helpCookieTitle": {
    "message": "Detección por cookies"
  },
  "helpCookieDescription": {
    "message": "Detecta cookies establecidas por challenges antibot. Coincide con el nombre de la cookie (y opcionalmente el patrón de valor)."
  },
  "helpCookieWarning": {
    "message": "Nombres de cookies con sufijos aleatorios (p. ej. _abck-xyz123) necesitan un patrón regex, no un nombre literal."
  },
  "helpCookieTip": {
    "message": "Usa Palabra completa para coincidencias exactas de nombre, o Regex para patrones de prefijo como ^datadome-."
  },
  "helpContentTitle": {
    "message": "Detección por contenido de página"
  },
  "helpContentDescription": {
    "message": "Busca patrones de texto dentro del HTML de la página y dentro de los tags script inline."
  },
  "helpContentWarning": {
    "message": "El escaneo completo de página puede ser lento en páginas grandes. Restringe con Solo comprobar scripts si la firma está en código JS."
  },
  "helpContentTip": {
    "message": "Usa Palabra completa para evitar falsos positivos por subcadenas dentro de palabras más grandes."
  },
  "helpDomTitle": {
    "message": "Detección por selector DOM"
  },
  "helpDomDescription": {
    "message": "Detecta elementos HTML usando selectores CSS. Se activa cuando el elemento coincidente está presente en el DOM."
  },
  "helpDomWarning": {
    "message": "Los selectores solo coinciden con elementos renderizados en el DOM real — no con los que están dentro de iframes o shadow roots."
  },
  "helpDomTip": {
    "message": "Usa selectores específicos como div#cf-challenge[data-ray] en lugar de genéricos para reducir falsos positivos."
  },
  "helpPayloadTitle": {
    "message": "Detección por payload de petición"
  },
