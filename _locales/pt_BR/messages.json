  "helpJsHooksTitle": {
    "message": "Detecção por JavaScript Hooks"
  },
  "helpJsHooksDescription": {
    "message": "Os hooks interceptam chamadas de APIs do navegador (Canvas, Audio, WebGL, etc.) para detectar código de fingerprinting anti-bot em tempo real, conforme a página acessa essas APIs."
  },
  "helpJsHooksWarning": {
    "message": "Os hooks precisam ser instalados em document_start antes que qualquer script da página seja executado — caso contrário, a página pode salvar referências às APIs originais antes que nosso shim esteja em vigor."
  },
  "helpJsHooksTip": {
    "message": "Adicione um alvo como CanvasRenderingContext2D.prototype.getImageData para detectar fingerprinting de canvas."
  },
  "helpWindowTitle": {
    "message": "Detecção de propriedades de window"
  },
  "helpWindowDescription": {
    "message": "Detecta objetos e propriedades JavaScript adicionadas ao objeto global window por scripts anti-bot."
  },
  "helpWindowWarning": {
    "message": "Alguns scripts anti-bot usam chaves Symbol() que não são enumeráveis — essas são mais difíceis de detectar."
  },
  "helpWindowTip": {
    "message": "Use condições como typeof object ou exists para verificar o tipo da propriedade."
  },
  "helpUrlTitle": {
    "message": "Detecção por padrão de URL"
  },
  "helpUrlDescription": {
    "message": "Compara URLs de recursos carregados (scripts, imagens, requisições de rede) com padrões."
  },
  "helpUrlWarning": {
    "message": "Os padrões diferenciam maiúsculas de minúsculas por padrão. Alterne a opção \"URL diferencia maiúsculas de minúsculas\" se precisar de correspondência sem distinção de caixa."
  },
  "helpUrlTip": {
    "message": "Use a opção Regex para padrões avançados como /\\/v\\d+\\/challenge/."
  },
  "helpHeaderTitle": {
    "message": "Detecção por cabeçalhos HTTP"
  },
  "helpHeaderDescription": {
    "message": "Detecta cabeçalhos HTTP de requisição e resposta definidos por middlewares anti-bot."
  },
  "helpHeaderWarning": {
    "message": "Alguns cabeçalhos só estão presentes na requisição inicial — certifique-se de que seu escopo inclua Requisição."
  },
  "helpHeaderTip": {
    "message": "Alvos comuns: x-akamai-bot-manager-token, cf-ray, x-shape-version."
  },
  "helpCookieTitle": {
    "message": "Detecção por cookies"
  },
  "helpCookieDescription": {
    "message": "Detecta cookies definidos por desafios anti-bot. Verifica o nome do cookie (e, opcionalmente, o padrão do valor)."
  },
  "helpCookieWarning": {
    "message": "Nomes de cookies com sufixos aleatórios (ex.: _abck-xyz123) precisam de um padrão regex, não de um nome literal."
  },
  "helpCookieTip": {
    "message": "Use \"Palavra inteira\" para correspondências de nome exato, ou Regex para padrões de prefixo como ^datadome-."
  },
  "helpContentTitle": {
    "message": "Detecção por conteúdo da página"
  },
  "helpContentDescription": {
    "message": "Pesquisa padrões de texto dentro do HTML da página e em tags de script inline."
  },
  "helpContentWarning": {
    "message": "A varredura de página inteira pode ser lenta em páginas grandes. Restrinja a \"Verificar apenas scripts\" se a assinatura estiver em código JS."
  },
  "helpContentTip": {
    "message": "Use \"Palavra inteira\" para evitar falsos positivos de substrings dentro de palavras maiores."
  },
  "helpDomTitle": {
    "message": "Detecção por seletor DOM"
  },
  "helpDomDescription": {
    "message": "Detecta elementos HTML usando seletores CSS. É disparado quando o elemento correspondente está presente no DOM."
