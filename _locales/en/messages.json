  "helpJsHooksTitle": {
    "message": "JavaScript Hooks Detection"
  },
  "helpJsHooksDescription": {
    "message": "Hooks intercept browser API calls (Canvas, Audio, WebGL, etc.) to detect anti-bot fingerprinting code in real-time as the page accesses those APIs."
  },
  "helpJsHooksWarning": {
    "message": "Hooks must install at document_start before any page script runs — otherwise the page can save references to the original APIs before our shim is in place."
  },
  "helpJsHooksTip": {
    "message": "Add a target like CanvasRenderingContext2D.prototype.getImageData to detect canvas fingerprinting."
  },
  "helpWindowTitle": {
    "message": "Window Properties Detection"
  },
  "helpWindowDescription": {
    "message": "Detects JavaScript objects and properties added to the window global by anti-bot scripts."
  },
  "helpWindowWarning": {
    "message": "Some anti-bot scripts use Symbol() keys that are not enumerable — those are harder to detect."
  },
  "helpWindowTip": {
    "message": "Use conditions like typeof object or exists to match against the property type."
  },
  "helpUrlTitle": {
    "message": "URL Pattern Detection"
  },
  "helpUrlDescription": {
    "message": "Matches URLs of loaded resources (scripts, images, network requests) against patterns."
  },
  "helpUrlWarning": {
    "message": "Patterns are case-sensitive by default. Toggle the URL Case Sensitive option if you need case-insensitive matching."
  },
  "helpUrlTip": {
    "message": "Use the Regex option for advanced patterns like /\\/v\\d+\\/challenge/."
  },
  "helpHeaderTitle": {
    "message": "HTTP Header Detection"
  },
  "helpHeaderDescription": {
    "message": "Detects HTTP request and response headers set by anti-bot middleware."
  },
  "helpHeaderWarning": {
    "message": "Some headers are only present on the initial request — make sure your scope includes Request."
  },
  "helpHeaderTip": {
    "message": "Common targets: x-akamai-bot-manager-token, cf-ray, x-shape-version."
  },
  "helpCookieTitle": {
    "message": "Cookie Detection"
  },
  "helpCookieDescription": {
    "message": "Detects cookies set by anti-bot challenges. Matches the cookie name (and optionally the value pattern)."
  },
  "helpCookieWarning": {
    "message": "Cookie names with random suffixes (e.g. _abck-xyz123) need a regex pattern, not a literal name."
  },
  "helpCookieTip": {
    "message": "Use Whole Word for exact-name matches, or Regex for prefix patterns like ^datadome-."
  },
  "helpContentTitle": {
    "message": "Page Content Detection"
  },
  "helpContentDescription": {
    "message": "Searches for text patterns inside the page HTML and inline script tags."
  },
  "helpContentWarning": {
    "message": "Full-page scanning can be slow on large pages. Restrict to Only check scripts if the signature is in JS code."
  },
  "helpContentTip": {
    "message": "Use Whole Word to avoid false positives from substrings inside larger words."
  },
  "helpDomTitle": {
    "message": "DOM Selector Detection"
  },
  "helpDomDescription": {
    "message": "Detects HTML elements using CSS selectors. Fires when the matching element is present in the DOM."
  },
  "helpDomWarning": {
    "message": "Selectors only match elements rendered into the actual DOM — not those inside iframes or shadow roots."
  },
  "helpDomTip": {
    "message": "Use specific selectors like div#cf-challenge[data-ray] rather than generic ones to reduce false positives."
  },
  "helpPayloadTitle": {
    "message": "Request Payload Detection"
  },
  "helpPayloadDescription": {
    "message": "Monitors all HTTP POST/PUT/PATCH request bodies for text patterns."
  },
  "helpPayloadWarning": {
    "message": "Payload monitoring only works for requests our extension can intercept (no encrypted bodies, no opaque blobs)."
  },
  "helpPayloadTip": {
    "message": "Combine with URL Pattern to limit matching to specific endpoints."
  },
  "helpWarningLabel": {
    "message": "Warning:"
  },
  "helpTipLabel": {
    "message": "Tip:"
  },
