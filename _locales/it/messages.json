  "helpJsHooksTitle": {
    "message": "Rilevamento tramite hook JavaScript"
  },
  "helpJsHooksDescription": {
    "message": "Gli hook intercettano le chiamate alle API del browser (Canvas, Audio, WebGL, ecc.) per rilevare in tempo reale il codice di fingerprinting anti-bot quando la pagina accede a tali API."
  },
  "helpJsHooksWarning": {
    "message": "Gli hook devono essere installati a document_start prima dell'esecuzione di qualsiasi script della pagina — altrimenti la pagina può salvare riferimenti alle API originali prima che il nostro shim sia attivo."
  },
  "helpJsHooksTip": {
    "message": "Aggiungi un target come CanvasRenderingContext2D.prototype.getImageData per rilevare il fingerprinting del canvas."
  },
  "helpWindowTitle": {
    "message": "Rilevamento proprietà window"
  },
  "helpWindowDescription": {
    "message": "Rileva oggetti e proprietà JavaScript aggiunti all'oggetto globale window dagli script anti-bot."
  },
  "helpWindowWarning": {
    "message": "Alcuni script anti-bot usano chiavi Symbol() che non sono enumerabili — queste sono più difficili da rilevare."
  },
  "helpWindowTip": {
    "message": "Usa condizioni come typeof object o exists per verificare il tipo della proprietà."
  },
  "helpUrlTitle": {
    "message": "Rilevamento tramite pattern URL"
  },
  "helpUrlDescription": {
    "message": "Confronta gli URL delle risorse caricate (script, immagini, richieste di rete) con i pattern."
  },
  "helpUrlWarning": {
    "message": "I pattern sono sensibili a maiuscole/minuscole per impostazione predefinita. Attiva/disattiva l'opzione URL Case Sensitive se hai bisogno di una corrispondenza non sensibile."
  },
  "helpUrlTip": {
    "message": "Usa l'opzione Regex per pattern avanzati come /\\/v\\d+\\/challenge/."
  },
  "helpHeaderTitle": {
    "message": "Rilevamento delle intestazioni HTTP"
  },
  "helpHeaderDescription": {
    "message": "Rileva le intestazioni delle richieste e risposte HTTP impostate dai middleware anti-bot."
  },
  "helpHeaderWarning": {
    "message": "Alcune intestazioni sono presenti solo nella richiesta iniziale — assicurati che il tuo ambito includa Richiesta."
  },
  "helpHeaderTip": {
    "message": "Target comuni: x-akamai-bot-manager-token, cf-ray, x-shape-version."
  },
  "helpCookieTitle": {
    "message": "Rilevamento dei cookie"
  },
  "helpCookieDescription": {
    "message": "Rileva i cookie impostati dalle challenge anti-bot. Confronta il nome del cookie (e facoltativamente il pattern del valore)."
  },
  "helpCookieWarning": {
    "message": "I nomi di cookie con suffissi casuali (es. _abck-xyz123) richiedono un pattern regex, non un nome letterale."
  },
  "helpCookieTip": {
    "message": "Usa Parola intera per corrispondenze esatte di nome, oppure Regex per pattern di prefisso come ^datadome-."
  },
  "helpContentTitle": {
    "message": "Rilevamento dei contenuti della pagina"
  },
  "helpContentDescription": {
    "message": "Cerca pattern di testo all'interno dell'HTML della pagina e nei tag script inline."
  },
  "helpContentWarning": {
    "message": "La scansione completa della pagina può essere lenta su pagine grandi. Limita a Controlla solo gli script se la firma è nel codice JS."
  },
  "helpContentTip": {
    "message": "Usa Parola intera per evitare falsi positivi da sottostringhe all'interno di parole più lunghe."
  },
  "helpDomTitle": {
    "message": "Rilevamento tramite selettore DOM"
  },
  "helpDomDescription": {
    "message": "Rileva elementi HTML usando selettori CSS. Si attiva quando l'elemento corrispondente è presente nel DOM."
  },
  "helpDomWarning": {
    "message": "I selettori corrispondono solo agli elementi resi nel DOM effettivo — non a quelli all'interno di iframe o shadow root."
