{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.0.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'none'; base-uri 'none'; form-action 'none'; object-src 'self'"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation",
    "webRequest",
    "cookies",
    "notifications",
    "downloads",
    "alarms",
    "unlimitedStorage"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "modules/detection/conditions/window-condition-evaluator.js",
        "modules/detection/hooks/hook-resilience-manager.js",
        "modules/detection/hooks/window-property-tracker.js",
        "content-main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "modules/core/bridge-protocol.js",
        "modules/core/worker-messages.js",
        "modules/core/logger.js",
        "modules/core/constants.js",
        "modules/core/hooks-config.js",
        "modules/detection/conditions/window-condition-grammar.js",
        "modules/core/categories.js",
        "modules/core/domain-list.js",
        "modules/core/scan-scope.js",
        "utils/format-utils.js",
        "utils/url-utils.js",
        "utils/detection-utils.js",
        "utils/utils.js",
        "utils/pattern-cache.js",
        "modules/core/storage-manager.js",
        "modules/detection/managers/confidence-manager.js",
        "modules/detection/detection-combinations.js",
        "modules/detection/engine/detection-engine-analysis.js",
        "modules/detection/engine/detection-engine-extractors.js",
        "modules/detection/engine/detection-engine-matching.js",
        "modules/detection/engine/detection-engine-hooks.js",
        "modules/detection/engine/detection-engine-manager.js",
        "modules/detection/public-summary.js",
        "modules/settings/settings-runtime.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "commands": {
    "rescan-tab": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S" },
      "description": "__MSG_commandRescanTab__"
    },
    "_execute_action": {
      "description": "__MSG_commandOpenPopup__"
    }
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrapfly: anti-bot detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
