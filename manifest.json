{
  "manifest_version": 3,
  "name": "Scrapfly",
  "version": "2.1",
  "description": "Detect CAPTCHAs, anti-bot systems, and fingerprinting technologies on websites",

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation",
    "webRequest",
    "cookies",
    "notifications",
    "downloads"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["modules/logger.js", "utils/debug.js", "utils/utils.js", "modules/storage-manager.js", "modules/confidence-manager.js", "modules/detection-engine-manager.js", "sections/settings/settings.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrapfly - Security Detection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "modules/notification-manager.css",
        "detectors/*/*",
        "sections/settings/default-settings.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}