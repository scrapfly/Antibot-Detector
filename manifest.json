{
  "manifest_version": 3,
  "name": "Scrapfly: anti-bot detector",
  "version": "2.5",
  "description": "Detect CAPTCHAs, anti-bot systems and fingerprinting technologies on websites",

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation",
    "webRequest",
    "cookies",
    "notifications",
    "downloads",
    "alarms"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "modules/detection/hooks/window-condition-language.js",
        "modules/detection/hooks/hook-resilience-manager.js",
        "modules/detection/hooks/window-property-tracker.js",
        "content-main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "modules/core/logger.js",
        "utils/format-utils.js",
        "utils/url-utils.js",
        "utils/detection-utils.js",
        "utils/utils.js",
        "utils/pattern-cache.js",
        "modules/core/storage-manager.js",
        "modules/detection/managers/confidence-manager.js",
        "modules/detection/engine/detection-engine-analysis.js",
        "modules/detection/engine/detection-engine-extractors.js",
        "modules/detection/engine/detection-engine-matching.js",
        "modules/detection/engine/detection-engine-hooks.js",
        "modules/detection/engine/detection-engine-manager.js",
        "sections/settings/settings-runtime.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrapfly: anti-bot detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "modules/styles/notification-manager.css",
        "detectors/*/*",
        "sections/settings/default-settings.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
