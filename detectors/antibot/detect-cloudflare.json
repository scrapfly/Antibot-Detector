{
  "id": "detect-cloudflare",
  "name": "Cloudflare Bot Management",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Anti-Bot",
  "difficulty": "Medium",
  "lastUpdated": "2026-10-26",
  "version": "2.3.0",
  "minExtensionVersion": "2.8",
  "website": "https://www.cloudflare.com/products/bot-management/",
  "icon": "cloudflare_official.png",
  "description": "AI-powered bot detection and mitigation with global CDN integration",
  "detection": {
    "cookie": [
      {
        "id": "cf-clearance-cookie",
        "name": "^cf_clearance$",
        "nameRegex": true,
        "confidence": 100,
        "description": "Challenge clearance cookie, set after passing a Cloudflare challenge",
        "nameScope": "all",
        "valueScope": "all",
        "value": "^[A-Za-z0-9_.-]{43}-[0-9]{10}-1\\.[0-9]\\.[0-9]\\.[0-9]-[A-Za-z0-9_.-]{20,}",
        "valueRegex": true,
        "valueCaseSensitive": true
      },
      {
        "id": "cf-bm-cookie",
        "name": "^__cf_bm$",
        "nameRegex": true,
        "confidence": 100,
        "description": "Bot Management cookie in its <token>-<timestamp.fraction>-1.x.x.x-<signature> shape; Cloudflare sets it on every zone with bot management or Bot Fight Mode",
        "nameScope": "all",
        "valueScope": "all",
        "value": "^[A-Za-z0-9_.-]{43}-[0-9]{10}\\.[0-9]{5,8}-1\\.[0-9]\\.[0-9]\\.[0-9]-[A-Za-z0-9_.-]{20,}",
        "valueRegex": true,
        "valueCaseSensitive": true
      },
      {
        "id": "cf-chl-rc-cookie",
        "name": "^cf_chl_rc_(?:i|ni|m)$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 85,
        "description": "Cloudflare challenge platform cookie (cf_chl_rc_i, cf_chl_rc_ni, cf_chl_rc_m)",
        "nameScope": "all",
        "valueScope": "all"
      }
    ],
    "header": [
      {
        "id": "cf-mitigated-header",
        "name": "^cf-mitigated$",
        "nameRegex": true,
        "value": "^challenge$",
        "valueRegex": true,
        "confidence": 100,
        "description": "Response header Cloudflare sends when it served a challenge page",
        "nameScope": "response",
        "valueScope": "response"
      },
      {
        "id": "cf-server-header",
        "name": "^server$",
        "nameRegex": true,
        "value": "^cloudflare$",
        "valueRegex": true,
        "confidence": 15,
        "standalone": false,
        "description": "Served through Cloudflare; CDN delivery, not bot management on its own",
        "nameScope": "response",
        "valueScope": "response"
      }
    ],
    "url": [
      {
        "id": "challenge-orchestrator",
        "confidence": 100,
        "description": "Challenge page orchestrator under /cdn-cgi/challenge-platform/",
        "text": "^https?://(?!challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/(?:h/[a-z0-9]+/)?orchestrate/(?:chl_page|managed|jsch|captcha)/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "bot-management-script",
        "confidence": 100,
        "description": "Bot Management JavaScript detections script",
        "text": "^https?://(?!challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/(?:h/[a-z0-9]+/)?scripts/jsd/(?:[0-9a-f]{6,20}/)?main\\.js(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "jsd-oneshot",
        "confidence": 100,
        "description": "Bot Management JavaScript detections report (/cdn-cgi/challenge-platform/…/jsd/oneshot/)",
        "text": "^https?://(?!challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/(?:h/[a-z0-9]+/)?jsd/oneshot/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "challenges-host",
        "confidence": 40,
        "standalone": false,
        "description": "Request to challenges.cloudflare.com; also used by Turnstile, so corroboration only",
        "text": "^https://challenges\\.cloudflare\\.com/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      }
    ],
    "content": [
      {
        "id": "chl-opt-reference",
        "confidence": 20,
        "description": "Script reference to the _cf_chl_opt challenge options object",
        "text": "_cf_chl_opt",
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      }
    ],
    "window": [
      {
        "id": "chl-opt-object",
        "path": "_cf_chl_opt",
        "condition": "typeof object",
        "confidence": 85,
        "description": "Challenge options object present on a Cloudflare challenge page"
      }
    ]
  },
  "combinations": [
    {
      "id": "cloudflare-challenge-page",
      "name": "Challenge page orchestrator and challenge options object",
      "confidence": 100,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "challenge-orchestrator"
              },
              {
                "pattern": "cf-mitigated-header"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "chl-opt-object"
              },
              {
                "pattern": "chl-opt-reference"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-cleared-session",
      "name": "Clearance cookie with Bot Management cookie",
      "confidence": 85,
      "when": {
        "all": [
          {
            "pattern": "cf-clearance-cookie"
          },
          {
            "any": [
              {
                "pattern": "cf-bm-cookie"
              },
              {
                "pattern": "cf-server-header"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-bot-management",
      "name": "Bot Management script on a Cloudflare zone",
      "confidence": 75,
      "when": {
        "all": [
          {
            "pattern": "bot-management-script"
          },
          {
            "any": [
              {
                "pattern": "cf-bm-cookie"
              },
              {
                "pattern": "cf-server-header"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-challenge-host",
      "name": "Challenge host request on a Cloudflare zone with a challenge signal",
      "confidence": 90,
      "when": {
        "all": [
          {
            "pattern": "challenges-host"
          },
          {
            "any": [
              {
                "pattern": "cf-clearance-cookie"
              },
              {
                "pattern": "chl-opt-object"
              },
              {
                "pattern": "challenge-orchestrator"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-challenge-cookie",
      "name": "Challenge platform cookie with a Cloudflare clearance, server header or challenge",
      "confidence": 95,
      "when": {
        "all": [
          {
            "pattern": "cf-chl-rc-cookie"
          },
          {
            "any": [
              {
                "pattern": "cf-clearance-cookie"
              },
              {
                "pattern": "cf-server-header"
              },
              {
                "pattern": "challenge-orchestrator"
              },
              {
                "pattern": "chl-opt-object"
              }
            ]
          }
        ]
      }
    }
  ]
}
