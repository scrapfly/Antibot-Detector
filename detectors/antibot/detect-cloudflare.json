{
  "id": "detect-cloudflare",
  "name": "Cloudflare Bot Management",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Anti-Bot",
  "difficulty": "Medium",
  "lastUpdated": "2026-11-12",
  "version": "2.4.0",
  "minExtensionVersion": "2.8",
  "website": "https://www.cloudflare.com/products/bot-management/",
  "icon": "cloudflare_official.png",
  "description": "AI-powered bot detection and mitigation with global CDN integration",
  "detection": {
    "cookie": [
      {
        "id": "cf-clearance-cookie",
        "name": "^cf_clearance$",
        "nameRegex": true,
        "confidence": 100,
        "description": "Challenge clearance cookie, set after passing a Cloudflare challenge",
        "nameScope": "all",
        "valueScope": "all",
        "value": "^[A-Za-z0-9_.-]{43}-[0-9]{10}-1\\.[0-9]\\.[0-9]\\.[0-9]-[A-Za-z0-9_.-]{20,}",
        "valueRegex": true,
        "valueCaseSensitive": true
      },
      {
        "id": "cf-bm-cookie",
        "name": "^__cf_bm$",
        "nameRegex": true,
        "confidence": 100,
        "description": "Bot Management cookie in its <token>-<timestamp.fraction>-1.x.x.x-<signature> shape; Cloudflare sets it on every zone with bot management or Bot Fight Mode",
        "nameScope": "all",
        "valueScope": "all",
        "value": "^[A-Za-z0-9_.-]{43}-[0-9]{10}\\.[0-9]{5,8}-1\\.[0-9]\\.[0-9]\\.[0-9]-[A-Za-z0-9_.-]{20,}",
        "valueRegex": true,
        "valueCaseSensitive": true
      },
      {
        "id": "cf-clearance-cookie-name",
        "name": "^cf_clearance$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 85,
        "description": "Challenge clearance cookie by name; its value is encrypted and its shape may change",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "cf-bm-cookie-name",
        "name": "^__cf_bm$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 85,
        "description": "Bot Management cookie by name; its value is encrypted and its shape may change",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "cf-chl-rc-cookie",
        "name": "^cf_chl_rc_(?:i|ni|m)$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 85,
        "description": "Cloudflare challenge platform cookie (cf_chl_rc_i, cf_chl_rc_ni, cf_chl_rc_m)",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "cfseq-cookie",
        "name": "^__cfseq(?:-[A-Za-z0-9_-]{1,64})?$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 90,
        "description": "Sequence cookie of Cloudflare's bot products (__cfseq)",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "cfuvid-cookie",
        "name": "^_cfuvid$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 50,
        "description": "Rate limiting cookie Cloudflare sets per visitor (_cfuvid); not bot management on its own",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "cfruid-cookie",
        "name": "^__cfruid$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 40,
        "description": "Cloudflare cookie that identifies trusted traffic (__cfruid); corroboration only",
        "nameScope": "all",
        "valueScope": "all",
        "standalone": false
      }
    ],
    "header": [
      {
        "id": "cf-mitigated-header",
        "name": "^cf-mitigated$",
        "nameRegex": true,
        "value": "^challenge$",
        "valueRegex": true,
        "confidence": 100,
        "description": "Response header Cloudflare sends when it served a challenge page",
        "nameScope": "response",
        "valueScope": "response"
      },
      {
        "id": "cf-server-header",
        "name": "^server$",
        "nameRegex": true,
        "value": "^cloudflare$",
        "valueRegex": true,
        "confidence": 15,
        "standalone": false,
        "description": "Served through Cloudflare; CDN delivery, not bot management on its own",
        "nameScope": "response",
        "valueScope": "response"
      }
    ],
    "url": [
      {
        "id": "challenge-orchestrator",
        "confidence": 100,
        "description": "Challenge page orchestrator under /cdn-cgi/challenge-platform/",
        "text": "^https?://(?!(?:[a-z0-9-]+\\.)?challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/(?:h/[a-z0-9]+/)?orchestrate/(?:chl_page|managed|jsch|captcha)/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "bot-management-script",
        "confidence": 100,
        "description": "Bot Management JavaScript detections script",
        "text": "^https?://(?!(?:[a-z0-9-]+\\.)?challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/(?:h/[a-z0-9]+/)?scripts/jsd/(?:[0-9a-f]{6,20}/)?(?:main|api)\\.js(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "jsd-oneshot",
        "confidence": 100,
        "description": "Bot Management JavaScript detections report (/cdn-cgi/challenge-platform/…/jsd/oneshot/)",
        "text": "^https?://(?!(?:[a-z0-9-]+\\.)?challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/(?:h/[a-z0-9]+/)?jsd/oneshot/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "challenge-pat",
        "confidence": 100,
        "description": "Private Access Token request of a Cloudflare challenge (/cdn-cgi/challenge-platform/…/pat/)",
        "text": "^https?://(?!(?:[a-z0-9-]+\\.)?challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/(?:h/[a-z0-9]+/)?pat/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "challenge-platform-path",
        "confidence": 80,
        "description": "Any other request under /cdn-cgi/challenge-platform/, the path of Cloudflare's challenges and bot detections",
        "text": "^https?://(?!(?:[a-z0-9-]+\\.)?challenges\\.(?:cloudflare\\.com|cloudflare-cn\\.com|fed\\.cloudflare\\.com)/)[^/?#]+/cdn-cgi/challenge-platform/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "challenges-host",
        "confidence": 40,
        "standalone": false,
        "description": "Request to challenges.cloudflare.com; also used by Turnstile, so corroboration only",
        "text": "^https://challenges\\.cloudflare\\.com/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      }
    ],
    "content": [
      {
        "id": "chl-opt-reference",
        "confidence": 20,
        "description": "Script reference to the _cf_chl_opt challenge options object",
        "text": "_cf_chl_opt",
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      }
    ],
    "window": [
      {
        "id": "chl-opt-object",
        "path": "_cf_chl_opt",
        "condition": "typeof object",
        "confidence": 85,
        "description": "Challenge options object present on a Cloudflare challenge page"
      },
      {
        "id": "jsd-execute-once",
        "path": "cloudflare.jsd.executeOnce",
        "condition": "typeof function",
        "confidence": 70,
        "description": "JavaScript detections function Cloudflare defines (window.cloudflare.jsd.executeOnce)"
      }
    ]
  },
  "combinations": [
    {
      "id": "cloudflare-challenge-page",
      "name": "Challenge page orchestrator and challenge options object",
      "confidence": 100,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "challenge-orchestrator"
              },
              {
                "pattern": "cf-mitigated-header"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "chl-opt-object"
              },
              {
                "pattern": "chl-opt-reference"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-cleared-session",
      "name": "Clearance cookie with Bot Management cookie",
      "confidence": 85,
      "when": {
        "all": [
          {
            "pattern": "cf-clearance-cookie"
          },
          {
            "any": [
              {
                "pattern": "cf-bm-cookie"
              },
              {
                "pattern": "cf-server-header"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-bot-management",
      "name": "Bot Management script on a Cloudflare zone",
      "confidence": 75,
      "when": {
        "all": [
          {
            "pattern": "bot-management-script"
          },
          {
            "any": [
              {
                "pattern": "cf-bm-cookie"
              },
              {
                "pattern": "cf-server-header"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-challenge-host",
      "name": "Challenge host request on a Cloudflare zone with a challenge signal",
      "confidence": 90,
      "when": {
        "all": [
          {
            "pattern": "challenges-host"
          },
          {
            "any": [
              {
                "pattern": "cf-clearance-cookie"
              },
              {
                "pattern": "chl-opt-object"
              },
              {
                "pattern": "challenge-orchestrator"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-challenge-cookie",
      "name": "Challenge platform cookie with a Cloudflare clearance, server header or challenge",
      "confidence": 95,
      "when": {
        "all": [
          {
            "pattern": "cf-chl-rc-cookie"
          },
          {
            "any": [
              {
                "pattern": "cf-clearance-cookie"
              },
              {
                "pattern": "cf-server-header"
              },
              {
                "pattern": "challenge-orchestrator"
              },
              {
                "pattern": "chl-opt-object"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-bot-cookie-zone",
      "name": "Cloudflare bot cookie with a Cloudflare server header or visitor cookie",
      "confidence": 95,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "cf-clearance-cookie-name"
              },
              {
                "pattern": "cf-bm-cookie-name"
              },
              {
                "pattern": "cfseq-cookie"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "cf-server-header"
              },
              {
                "pattern": "cfruid-cookie"
              },
              {
                "pattern": "cfuvid-cookie"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cloudflare-platform-zone",
      "name": "Challenge platform request or detections runtime on a Cloudflare zone",
      "confidence": 90,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "challenge-platform-path"
              },
              {
                "pattern": "jsd-execute-once"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "cf-server-header"
              },
              {
                "pattern": "cf-bm-cookie-name"
              },
              {
                "pattern": "cfuvid-cookie"
              }
            ]
          }
        ]
      }
    }
  ]
}
