{
  "id": "detect-netacea",
  "name": "Netacea",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Anti-Bot",
  "difficulty": "Medium",
  "lastUpdated": "2026-10-06",
  "version": "2.0.0",
  "minExtensionVersion": "2.8",
  "website": "https://www.netacea.com/",
  "icon": "netacea_official.png",
  "description": "Netacea agentless bot management; cookie names are deployment defaults and can be customer-renamed",
  "detection": {
    "cookie": [
      {
        "id": "mitata-request-cookie",
        "name": "^_mitata$",
        "nameRegex": true,
        "confidence": 55,
        "description": "Netacea mitigation cookie observed in the browser's cookie jar (default name)",
        "nameScope": "request",
        "valueScope": "request"
      },
      {
        "id": "mitata-response-cookie",
        "name": "^_mitata$",
        "nameRegex": true,
        "confidence": 60,
        "description": "Netacea mitigation cookie observed while being set by the server (default name)",
        "nameScope": "response",
        "valueScope": "response"
      },
      {
        "id": "mitatacaptcha-cookie",
        "name": "^_mitatacaptcha$",
        "nameRegex": true,
        "confidence": 70,
        "description": "Netacea captcha-serving cookie (default name)",
        "nameScope": "all",
        "valueScope": "all"
      }
    ],
    "url": [
      {
        "id": "netacea-captcha-verify",
        "confidence": 75,
        "description": "First-party Netacea captcha verification endpoint (default path in the vendor integrations)",
        "text": "^https?://[^/?#]+/AtaVerifyCaptcha(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      }
    ]
  },
  "combinations": [
    {
      "id": "netacea-session-cookie",
      "name": "Mitigation cookie both set by the server and echoed by the browser",
      "confidence": 80,
      "when": {
        "all": [
          { "pattern": "mitata-request-cookie" },
          { "pattern": "mitata-response-cookie" }
        ]
      }
    },
    {
      "id": "netacea-captcha-session",
      "name": "Captcha cookie with a mitigation cookie",
      "confidence": 90,
      "when": {
        "all": [
          { "pattern": "mitatacaptcha-cookie" },
          {
            "any": [
              { "pattern": "mitata-request-cookie" },
              { "pattern": "mitata-response-cookie" }
            ]
          }
        ]
      }
    },
    {
      "id": "netacea-captcha-verified",
      "name": "Captcha verification with a Netacea cookie",
      "confidence": 90,
      "when": {
        "all": [
          { "pattern": "netacea-captcha-verify" },
          {
            "any": [
              { "pattern": "mitata-request-cookie" },
              { "pattern": "mitata-response-cookie" },
              { "pattern": "mitatacaptcha-cookie" }
            ]
          }
        ]
      }
    },
    {
      "id": "netacea-complete-profile",
      "name": "Captcha cookie with the mitigation cookie set and echoed",
      "confidence": 95,
      "when": {
        "all": [
          { "pattern": "mitatacaptcha-cookie" },
          { "pattern": "mitata-request-cookie" },
          { "pattern": "mitata-response-cookie" }
        ]
      }
    }
  ]
}
