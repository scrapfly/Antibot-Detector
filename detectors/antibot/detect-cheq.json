{
  "id": "detect-cheq",
  "name": "Cheq",
  "author": "Scrapfly",
  "enabled": true,
  "category": "ANTIBOT",
  "difficulty": "Medium",
  "lastUpdated": "2026-10-05",
  "version": "2.0.0",
  "minExtensionVersion": "2.8",
  "website": "https://cheq.ai/",
  "icon": "custom.png",
  "description": "Cheq bot detection and prevention with light obfuscation",
  "detection": {
    "cookie": [
      {
        "id": "cq-id-cookie",
        "name": "^_cq_(?:duid|suid)$",
        "nameRegex": true,
        "confidence": 50,
        "description": "CHEQ visitor/session id cookie",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "cq-aux-cookie",
        "name": "^(?:_cq_session|_cq_rti|_cheq_rti)$",
        "nameRegex": true,
        "confidence": 30,
        "standalone": false,
        "description": "Other CHEQ cookies",
        "nameScope": "all",
        "valueScope": "all"
      }
    ],
    "url": [
      {
        "id": "cheq-tms-bootstrap",
        "confidence": 75,
        "description": "CHEQ tag manager bootstrap (tms.cheq.ai)",
        "text": "^https://tms\\.cheq\\.ai/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "cheqzone-host",
        "confidence": 70,
        "description": "CHEQ ClickTrue host (cheqzone.com)",
        "text": "^https://(?:[a-z0-9-]{1,63}\\.){0,4}cheqzone\\.com/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "cheq-ai-host",
        "confidence": 50,
        "standalone": false,
        "description": "Other cheq.ai service host",
        "text": "^https://(?:[a-z0-9-]{1,63}\\.){0,4}cheq\\.ai/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      }
    ],
    "dom": [
      {
        "id": "clicktrue-tag",
        "selector": "script[class^=\"ct_clicktrue_\"]",
        "confidence": 80,
        "description": "ClickTrue tag; served from a disguised random host, identified by its class"
      },
      {
        "id": "cheq-jsonp-tag",
        "selector": "script[data-jsonp=\"onCheqResponse\"]",
        "confidence": 80,
        "description": "CHEQ tag with its JSONP callback attribute"
      }
    ],
    "content": [
      {
        "id": "cheq-callback-reference",
        "confidence": 10,
        "description": "CHEQ JSONP callback name",
        "text": "onCheqResponse",
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      },
      {
        "id": "cheq-sdk-reference",
        "confidence": 10,
        "description": "CHEQ SDK global reference",
        "text": "__CheqSdk",
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      }
    ],
    "window": [
      {
        "id": "cheq-sdk-object",
        "path": "__CheqSdk",
        "condition": "exists",
        "confidence": 75,
        "description": "CHEQ SDK global"
      },
      {
        "id": "cq-object",
        "path": "_cq",
        "condition": "typeof object",
        "confidence": 40,
        "standalone": false,
        "description": "CHEQ queue object (_cq)"
      }
    ]
  },
  "combinations": [
    {
      "id": "cheq-tag-runtime",
      "name": "CHEQ tag with its runtime or cookies",
      "confidence": 95,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "clicktrue-tag"
              },
              {
                "pattern": "cheq-jsonp-tag"
              },
              {
                "pattern": "cheq-tms-bootstrap"
              },
              {
                "pattern": "cheqzone-host"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "cheq-sdk-object"
              },
              {
                "pattern": "cq-object"
              },
              {
                "pattern": "cq-id-cookie"
              },
              {
                "pattern": "cq-aux-cookie"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cheq-cookies-runtime",
      "name": "CHEQ cookies with its queue",
      "confidence": 85,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "cq-id-cookie"
              },
              {
                "pattern": "cq-aux-cookie"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "cq-object"
              },
              {
                "pattern": "cheq-callback-reference"
              },
              {
                "pattern": "cheq-sdk-reference"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cheq-host-cookies",
      "name": "cheq.ai service host with CHEQ cookie",
      "confidence": 80,
      "when": {
        "all": [
          {
            "pattern": "cheq-ai-host"
          },
          {
            "any": [
              {
                "pattern": "cq-id-cookie"
              },
              {
                "pattern": "cq-aux-cookie"
              }
            ]
          }
        ]
      }
    }
  ]
}
