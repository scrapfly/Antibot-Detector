{
  "id": "detect-meetrics",
  "name": "Meetrics Check",
  "author": "Scrapfly",
  "enabled": true,
  "category": "ANTIBOT",
  "difficulty": "Medium",
  "lastUpdated": "2026-10-05",
  "version": "2.0.0",
  "website": "https://www.meetrics.com/en/",
  "icon": "custom.png",
  "description": "Legacy Meetrics ad-fraud and viewability tag. Its mxcdn.net host is parked, so only old integrations still reference it.",
  "detection": {
    "url": [
      {
        "id": "meetrics-serve",
        "confidence": 40,
        "description": "Legacy Meetrics tag (mxcdn.net, now parked)",
        "text": "^https://(?:[a-z0-9-]{1,63}\\.){0,4}mxcdn\\.net/bb-mx/serve/mtrcs_[0-9]+\\.js(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "meetrics-host",
        "confidence": 20,
        "standalone": false,
        "description": "Legacy meetrics.com/.net host",
        "text": "^https://(?:[a-z0-9-]{1,63}\\.){0,4}meetrics\\.(?:com|net)/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      }
    ],
    "content": [
      {
        "id": "meetrics-global-reference",
        "confidence": 5,
        "description": "Meetrics global reference in scripts",
        "text": "meetricsGlobal",
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      }
    ],
    "window": [
      {
        "id": "meetrics-global-object",
        "path": "meetricsGlobal",
        "condition": "typeof object",
        "confidence": 40,
        "description": "Meetrics global object"
      }
    ]
  },
  "combinations": [
    {
      "id": "meetrics-tag-runtime",
      "name": "Legacy tag with its runtime",
      "confidence": 60,
      "when": {
        "all": [
          {
            "pattern": "meetrics-serve"
          },
          {
            "pattern": "meetrics-global-object"
          }
        ]
      }
    },
    {
      "id": "meetrics-host-runtime",
      "name": "Meetrics host traffic with its runtime",
      "confidence": 50,
      "when": {
        "all": [
          {
            "pattern": "meetrics-host"
          },
          {
            "any": [
              {
                "pattern": "meetrics-global-object"
              },
              {
                "pattern": "meetrics-global-reference"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "meetrics-tag-reference",
      "name": "Legacy tag referenced in page scripts",
      "confidence": 45,
      "when": {
        "all": [
          {
            "pattern": "meetrics-serve"
          },
          {
            "pattern": "meetrics-global-reference"
          }
        ]
      }
    }
  ]
}
