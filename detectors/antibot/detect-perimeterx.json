{
  "id": "detect-perimeterx",
  "name": "HUMAN (PerimeterX)",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Anti-Bot",
  "difficulty": "High",
  "lastUpdated": "2026-11-12",
  "version": "2.4.0",
  "minExtensionVersion": "2.8",
  "website": "https://www.humansecurity.com/",
  "icon": "perimeterx_official.png",
  "description": "Behavioral-based bot detection with real-time risk scoring (HUMAN Security)",
  "detection": {
    "cookie": [
      {
        "id": "px3-cookie",
        "name": "^_px[23]$",
        "nameRegex": true,
        "confidence": 100,
        "description": "PerimeterX risk token cookie (_px2 or _px3)",
        "nameScope": "all",
        "valueScope": "all",
        "value": "^[0-9a-f]{64}:[A-Za-z0-9+/=_-]{20,}",
        "valueRegex": true
      },
      {
        "id": "pxhd-cookie",
        "name": "^_pxhd$",
        "nameRegex": true,
        "confidence": 100,
        "description": "PerimeterX first-party server cookie",
        "nameScope": "all",
        "valueScope": "all",
        "value": "^[A-Za-z0-9+/=_-]{60,120}(?::|$)",
        "valueRegex": true
      },
      {
        "id": "pxvid-cookie",
        "name": "^_pxvid$",
        "nameRegex": true,
        "confidence": 100,
        "description": "PerimeterX visitor ID cookie",
        "nameScope": "all",
        "valueScope": "all",
        "value": "^[0-9a-f]{8}-[0-9a-f]{4}-1[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "valueRegex": true
      },
      {
        "id": "px-aux-cookie",
        "name": "^(?:pxcts|_pxde|_pxff_[A-Za-z0-9_]+)$",
        "nameRegex": true,
        "confidence": 50,
        "standalone": false,
        "description": "Auxiliary PerimeterX cookies (pxcts, _pxde, _pxff_*)",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "px-documented-cookie",
        "name": "^(?:_pxmvid|_pxttld|_pxwvm|_pxmd|_pxda|_pxac)$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 60,
        "description": "Other cookies HUMAN documents for its sensor (_pxmvid, _pxttld, _pxwvm, _pxmd, _pxda, _pxac)",
        "nameScope": "all",
        "valueScope": "all"
      },
      {
        "id": "px-code-defender-cookie",
        "name": "^__pxvid$",
        "nameRegex": true,
        "nameCaseSensitive": true,
        "confidence": 60,
        "description": "HUMAN Code Defender visitor cookie (__pxvid)",
        "nameScope": "all",
        "valueScope": "all"
      }
    ],
    "header": [],
    "url": [
      {
        "id": "px-client-script",
        "confidence": 100,
        "description": "PerimeterX client script on its own hosts, keyed by the PX app ID",
        "text": "^https://client\\.(?:px-cloud\\.net|perimeterx\\.net|hsprotect\\.net)/PX[A-Za-z0-9]{6,10}/main\\.min\\.js(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "px-first-party-script",
        "confidence": 75,
        "description": "First-party PerimeterX script (/PXxxxx/init.js or under a proxy prefix such as /px/PXxxxx/init.js)",
        "text": "^https?://[^/?#]+/(?:[a-z0-9]{1,12}/)?PX[A-Za-z0-9]{6,10}/(?:init|main\\.min)\\.js(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": true,
        "textScope": "all"
      },
      {
        "id": "px-collector",
        "confidence": 100,
        "description": "PerimeterX collector endpoint",
        "text": "^https://collector-(?:PX[A-Za-z0-9]{6,10}|[a-z])\\.(?:px-cloud\\.net|perimeterx\\.net|hsprotect\\.net)/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "px-captcha",
        "confidence": 100,
        "description": "PerimeterX challenge (Press & Hold) script host",
        "text": "^https://captcha\\.px-cdn\\.net/PX[A-Za-z0-9]{6,10}/",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "px-first-party-captcha",
        "confidence": 30,
        "standalone": false,
        "description": "First-party PerimeterX captcha script on an app-id path without the PX prefix (/HYx10rg3/captcha/captcha.js)",
        "text": "^https?://[^/?#]+/[A-Za-z0-9]{8}/captcha/captcha\\.js(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": true,
        "textScope": "all"
      },
      {
        "id": "px-vendor-host",
        "confidence": 100,
        "description": "Request to a HUMAN (PerimeterX) sensor, collector or challenge host",
        "text": "^https://(?:[a-z0-9-]+\\.)+(?:px-cloud\\.net|px-cdn\\.net|px-client\\.net|pxchk\\.net|perimeterx\\.net|hsprotect\\.net)(?:[/?#:]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "px-first-party-collector",
        "confidence": 85,
        "description": "First-party HUMAN collector under the app ID (/<appid>/xhr/api/v1/collector)",
        "text": "^https?://[^/?#]+/(?:PX)?[A-Za-z0-9]{8}/xhr/api/v[0-9]/collector(?:[/?#]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "px-first-party-init",
        "confidence": 30,
        "description": "First-party init.js under an app-ID path without the PX prefix; corroboration only",
        "text": "^https?://[^/?#]+/[A-Za-z0-9]{8}/init\\.js(?:[?#]|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all",
        "standalone": false
      }
    ],
    "content": [
      {
        "id": "px-appid-reference",
        "confidence": 25,
        "description": "Script assigning the PerimeterX app ID (window._pxAppId)",
        "text": "_pxAppId",
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      }
    ],
    "window": [
      {
        "id": "px-appid-variable",
        "path": "_pxAppId",
        "condition": "typeof string",
        "confidence": 70,
        "description": "PerimeterX application ID"
      },
      {
        "id": "px-init-function",
        "path": "pxInit",
        "condition": "typeof function",
        "confidence": 30,
        "standalone": false,
        "description": "Optional PerimeterX init callback defined by the site"
      },
      {
        "id": "px-block-uuid",
        "path": "_pxUuid",
        "condition": "typeof string",
        "confidence": 60,
        "description": "HUMAN block page variable (_pxUuid, _pxVid, _pxBlockedUrl, _pxJsClientSrc)"
      },
      {
        "id": "px-block-vid",
        "path": "_pxVid",
        "condition": "typeof string",
        "confidence": 60,
        "description": "HUMAN block page variable (_pxUuid, _pxVid, _pxBlockedUrl, _pxJsClientSrc)"
      },
      {
        "id": "px-block-blockedurl",
        "path": "_pxBlockedUrl",
        "condition": "typeof string",
        "confidence": 60,
        "description": "HUMAN block page variable (_pxUuid, _pxVid, _pxBlockedUrl, _pxJsClientSrc)"
      },
      {
        "id": "px-block-jsclientsrc",
        "path": "_pxJsClientSrc",
        "condition": "typeof string",
        "confidence": 60,
        "description": "HUMAN block page variable (_pxUuid, _pxVid, _pxBlockedUrl, _pxJsClientSrc)"
      }
    ],
    "dom": [
      {
        "id": "px-captcha-container",
        "selector": "div#px-captcha",
        "confidence": 60,
        "description": "HUMAN challenge container (div#px-captcha)"
      }
    ]
  },
  "combinations": [
    {
      "id": "perimeterx-script-session",
      "name": "PerimeterX script or app ID with its cookies",
      "confidence": 100,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "px-client-script"
              },
              {
                "pattern": "px-first-party-script"
              },
              {
                "pattern": "px-appid-variable"
              },
              {
                "pattern": "px-collector"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "px3-cookie"
              },
              {
                "pattern": "pxhd-cookie"
              },
              {
                "pattern": "pxvid-cookie"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "perimeterx-cookie-set",
      "name": "Several PerimeterX cookies together",
      "confidence": 100,
      "when": {
        "atLeast": 2,
        "of": [
          {
            "pattern": "px3-cookie"
          },
          {
            "pattern": "pxhd-cookie"
          },
          {
            "pattern": "pxvid-cookie"
          },
          {
            "pattern": "px-aux-cookie"
          }
        ]
      }
    },
    {
      "id": "perimeterx-challenge",
      "name": "PerimeterX challenge with the app ID",
      "confidence": 100,
      "when": {
        "all": [
          {
            "pattern": "px-captcha"
          },
          {
            "any": [
              {
                "pattern": "px-appid-variable"
              },
              {
                "pattern": "px-appid-reference"
              },
              {
                "pattern": "px-init-function"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "perimeterx-first-party-challenge",
      "name": "First-party PerimeterX challenge with the app ID",
      "confidence": 95,
      "when": {
        "all": [
          {
            "pattern": "px-first-party-captcha"
          },
          {
            "any": [
              {
                "pattern": "px-appid-variable"
              },
              {
                "pattern": "px-appid-reference"
              },
              {
                "pattern": "px-init-function"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "perimeterx-first-party-sensor",
      "name": "First-party HUMAN sensor with its app ID or cookies",
      "confidence": 95,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "px-first-party-init"
              },
              {
                "pattern": "px-first-party-collector"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "px-appid-variable"
              },
              {
                "pattern": "px-appid-reference"
              },
              {
                "pattern": "px-init-function"
              },
              {
                "pattern": "px-aux-cookie"
              },
              {
                "pattern": "px-documented-cookie"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "perimeterx-block-page",
      "name": "HUMAN block page with its challenge",
      "confidence": 95,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "px-block-uuid"
              },
              {
                "pattern": "px-block-vid"
              },
              {
                "pattern": "px-block-blockedurl"
              },
              {
                "pattern": "px-block-jsclientsrc"
              },
              {
                "pattern": "px-captcha-container"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "px-captcha"
              },
              {
                "pattern": "px-first-party-captcha"
              },
              {
                "pattern": "px-vendor-host"
              }
            ]
          }
        ]
      }
    }
  ]
}
