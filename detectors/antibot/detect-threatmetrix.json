{
  "id": "detect-threatmetrix",
  "name": "ThreatMetrix",
  "author": "Scrapfly",
  "enabled": true,
  "category": "ANTIBOT",
  "difficulty": "Medium",
  "lastUpdated": "2026-10-05",
  "version": "2.0.0",
  "website": "https://www.threatmetrix.com/",
  "icon": "custom.png",
  "description": "LexisNexis ThreatMetrix fingerprinting service for fraud prevention and device identification",
  "detection": {
    "url": [
      {
        "id": "tmx-tags",
        "confidence": 85,
        "description": "ThreatMetrix profiling tag (fp/tags.js?org_id=...)",
        "text": "^https://(?:h\\.online-metrix\\.net|[a-z0-9-]+\\.online-metrix\\.net)/fp/tags(?:\\.js)?\\?(?:[^#]*&)?org_id=",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "tmx-check",
        "confidence": 70,
        "description": "ThreatMetrix profiling resource (check.js, sym.map, clear.png)",
        "text": "^https://(?:h\\.online-metrix\\.net|[a-z0-9-]+\\.online-metrix\\.net)/fp/(?:check\\.js|clear\\.png|sym\\.map|ls_fp\\.html)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "tmx-first-party-tags",
        "confidence": 50,
        "standalone": false,
        "description": "First-party (CNAME) ThreatMetrix tag with org_id and session_id",
        "text": "^https?://[^/?#]+/fp/tags(?:\\.js)?\\?(?:[^#]*&)?org_id=[A-Za-z0-9]{6,12}&(?:[^#]*&)?session_id=",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      }
    ],
    "content": [
      {
        "id": "tmx-profiling-reference",
        "confidence": 10,
        "description": "ThreatMetrix profiling globals in scripts",
        "text": "tmx_(?:profiling_started|run_page_fingerprinting)",
        "textRegex": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      }
    ],
    "window": [
      {
        "id": "tmx-profiling-flag",
        "path": "tmx_profiling_started",
        "condition": "typeof boolean",
        "confidence": 70,
        "description": "ThreatMetrix profiling flag"
      },
      {
        "id": "tmx-page-fingerprint",
        "path": "tmx_run_page_fingerprinting",
        "condition": "typeof function",
        "confidence": 60,
        "description": "ThreatMetrix page fingerprint function"
      }
    ]
  },
  "combinations": [
    {
      "id": "tmx-tag-running",
      "name": "Profiling tag with its runtime",
      "confidence": 95,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "tmx-tags"
              },
              {
                "pattern": "tmx-first-party-tags"
              }
            ]
          },
          {
            "any": [
              {
                "pattern": "tmx-profiling-flag"
              },
              {
                "pattern": "tmx-page-fingerprint"
              },
              {
                "pattern": "tmx-profiling-reference"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "tmx-tag-resources",
      "name": "Profiling tag with its follow-up resources",
      "confidence": 90,
      "when": {
        "all": [
          {
            "any": [
              {
                "pattern": "tmx-tags"
              },
              {
                "pattern": "tmx-first-party-tags"
              }
            ]
          },
          {
            "pattern": "tmx-check"
          }
        ]
      }
    },
    {
      "id": "tmx-first-party-runtime",
      "name": "First-party tag with ThreatMetrix resources or flag",
      "confidence": 80,
      "when": {
        "all": [
          {
            "pattern": "tmx-first-party-tags"
          },
          {
            "any": [
              {
                "pattern": "tmx-check"
              },
              {
                "pattern": "tmx-profiling-flag"
              }
            ]
          }
        ]
      }
    }
  ]
}
