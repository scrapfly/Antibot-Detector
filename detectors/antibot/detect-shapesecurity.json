{
  "id": "detect-shapesecurity",
  "name": "Shape Security",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Anti-Bot",
  "difficulty": "Medium",
  "lastUpdated": "2026-10-05",
  "version": "2.0.0",
  "website": "https://www.shapesecurity.com/products/bot-manager",
  "icon": "shape_security_official.png",
  "description": "Enterprise-grade bot management solution providing real-time detection and mitigation",
  "detection": {
    "url": [
      {
        "id": "seeded-script",
        "confidence": 85,
        "description": "Shape loader with its long seed parameter (ssx.mod.js?seed=...)",
        "text": "^https?://[^/?#]+/[A-Za-z0-9/_.-]{1,80}\\.js\\?(?:[^#]*&)?seed=[A-Za-z0-9_-]{40,}",
        "textRegex": true,
        "textCaseSensitive": true,
        "textScope": "all"
      },
      {
        "id": "shape-loader-async",
        "confidence": 60,
        "standalone": false,
        "description": "Shape ssx.mod.js loader (Target, Nordstrom)",
        "text": "^https?://[^/?#]+/[A-Za-z0-9/_.-]{0,60}/ssx\\.mod\\.js(?:\\?async)?(?:#|$)",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all"
      },
      {
        "id": "shape-marker-param",
        "confidence": 50,
        "standalone": false,
        "description": "Shape seeded-script marker parameter (X-xxxxxxxx--z=q)",
        "text": "^https?://[^/?#]+/[A-Za-z0-9/_.-]{1,80}\\.js\\?(?:[^#]*&)?X-[A-Za-z0-9]{6,10}--z=q(?:&|#|$)",
        "textRegex": true,
        "textCaseSensitive": true,
        "textScope": "all"
      }
    ],
    "content": [
      {
        "id": "xr-bmobdb-reference",
        "confidence": 10,
        "description": "Shape runtime global reference",
        "text": "__xr_bmobdb",
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true
      }
    ],
    "window": [
      {
        "id": "xr-bmobdb-object",
        "path": "__xr_bmobdb",
        "condition": "exists",
        "confidence": 80,
        "description": "Shape runtime global (__xr_bmobdb)"
      }
    ]
  },
  "combinations": [
    {
      "id": "shape-seeded-runtime",
      "name": "Seeded loader with its runtime",
      "confidence": 95,
      "when": {
        "all": [
          {
            "pattern": "seeded-script"
          },
          {
            "any": [
              {
                "pattern": "xr-bmobdb-object"
              },
              {
                "pattern": "xr-bmobdb-reference"
              },
              {
                "pattern": "shape-marker-param"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "shape-loader-runtime",
      "name": "ssx.mod.js loader with the Shape runtime",
      "confidence": 90,
      "when": {
        "all": [
          {
            "pattern": "shape-loader-async"
          },
          {
            "any": [
              {
                "pattern": "xr-bmobdb-object"
              },
              {
                "pattern": "seeded-script"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "shape-loader-marker",
      "name": "ssx.mod.js loader with the seeded-script marker",
      "confidence": 80,
      "when": {
        "all": [
          {
            "pattern": "shape-loader-async"
          },
          {
            "pattern": "shape-marker-param"
          }
        ]
      }
    }
  ]
}
