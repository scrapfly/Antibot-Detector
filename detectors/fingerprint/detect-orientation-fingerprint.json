{
  "id": "detect-orientation-fingerprint",
  "name": "Device Orientation Fingerprint",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Fingerprint",
  "difficulty": "Low",
  "lastUpdated": "2026-10-26",
  "version": "1.3.0",
  "minExtensionVersion": "2.8",
  "website": "https://developer.mozilla.org/en-US/docs/Web/API/DeviceOrientationEvent",
  "icon": "orientation_fingerprint.png",
  "description": "Reads of orientation and motion sensor values, and script references to those APIs",
  "detection": {
    "js_hooks": [
      {
        "id": "orientation-alpha-read",
        "description": "Reads the device rotation angle from an orientation event",
        "enabled": true,
        "confidence": 15,
        "standalone": true,
        "target": "DeviceOrientationEvent.prototype.alpha",
        "optional": true
      },
      {
        "id": "orientation-beta-read",
        "description": "Reads the front-to-back tilt from an orientation event",
        "enabled": true,
        "confidence": 15,
        "standalone": true,
        "target": "DeviceOrientationEvent.prototype.beta",
        "optional": true
      },
      {
        "id": "orientation-gamma-read",
        "description": "Reads the left-to-right tilt from an orientation event",
        "enabled": true,
        "confidence": 15,
        "standalone": true,
        "target": "DeviceOrientationEvent.prototype.gamma",
        "optional": true
      },
      {
        "id": "motion-acceleration-read",
        "description": "Reads the acceleration from a motion event",
        "enabled": true,
        "confidence": 15,
        "standalone": true,
        "target": "DeviceMotionEvent.prototype.accelerationIncludingGravity",
        "optional": true
      },
      {
        "id": "motion-rotation-read",
        "description": "Reads the rotation rate from a motion event",
        "enabled": true,
        "confidence": 15,
        "standalone": true,
        "target": "DeviceMotionEvent.prototype.rotationRate",
        "optional": true
      }
    ],
    "content": [
      {
        "id": "content-1",
        "text": "deviceorientation",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to deviceorientation (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false
      },
      {
        "id": "content-2",
        "text": "devicemotion",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to devicemotion (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false
      },
      {
        "id": "content-3",
        "text": "DeviceOrientationEvent",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to DeviceOrientationEvent (availability checks and ordinary applications also match)",
        "confidence": 5,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true
      },
      {
        "id": "content-motion-event",
        "text": "DeviceMotionEvent",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to DeviceMotionEvent (availability checks and ordinary applications also match)",
        "confidence": 5,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true
      }
    ]
  },
  "combinations": [
    {
      "id": "orientation-motion-api-references",
      "name": "Orientation and motion API names referenced in scripts",
      "confidence": 10,
      "when": { "all": [{ "pattern": "content-3" }, { "pattern": "content-motion-event" }] }
    },
    {
      "id": "orientation-motion-event-references",
      "name": "Orientation and motion event names referenced in scripts; collection unconfirmed",
      "confidence": 15,
      "when": { "all": [{ "pattern": "content-1" }, { "pattern": "content-2" }] }
    },
    {
      "id": "orientation-motion-sensor-reads",
      "name": "Orientation angles and motion values read from sensor events",
      "confidence": 40,
      "when": { "all": [{ "any": [{ "pattern": "orientation-alpha-read" }, { "pattern": "orientation-beta-read" }, { "pattern": "orientation-gamma-read" }] }, { "any": [{ "pattern": "motion-acceleration-read" }, { "pattern": "motion-rotation-read" }] }] }
    }
  ]
}
