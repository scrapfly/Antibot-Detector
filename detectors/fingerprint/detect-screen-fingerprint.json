{
  "id": "detect-screen-fingerprint",
  "name": "Screen Fingerprint",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Fingerprint",
  "difficulty": "Low",
  "lastUpdated": "2026-10-03",
  "version": "1.2.0",
  "minExtensionVersion": "2.8",
  "website": "https://developer.mozilla.org/en-US/docs/Web/API/Screen",
  "icon": "screen_fingerprint.png",
  "description": "Screen geometry, color depth and pixel ratio observations, also common in responsive display code",
  "detection": {
    "js_hooks": [
      { "id": "screen-width", "description": "Reads screen width", "enabled": true, "confidence": 10, "target": "Screen.prototype.width", "standalone": true },
      { "id": "screen-height", "description": "Reads screen height", "enabled": true, "confidence": 10, "target": "Screen.prototype.height", "standalone": true },
      { "id": "screen-available", "description": "Reads available screen height", "enabled": true, "confidence": 15, "target": "Screen.prototype.availHeight", "standalone": true },
      { "id": "screen-color", "description": "Reads screen color depth", "enabled": true, "confidence": 20, "target": "Screen.prototype.colorDepth", "standalone": true },
      { "id": "screen-inner-height", "description": "Reads window inner height", "enabled": false, "confidence": 5, "target": "window.innerHeight", "standalone": false },
      { "id": "screen-pixel-ratio", "description": "Reads device pixel ratio", "enabled": true, "confidence": 10, "target": "window.devicePixelRatio", "standalone": true }
    ],
    "content": [
      { "id": "screen-width-source", "text": "screen.width", "scope": "scripts", "checkScripts": true, "description": "Script references screen width; execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true },
      { "id": "screen-height-source", "text": "screen.height", "scope": "scripts", "checkScripts": true, "description": "Script references screen height; execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true },
      { "id": "screen-available-source", "text": "screen.availHeight", "scope": "scripts", "checkScripts": true, "description": "Script references available screen height; execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true },
      { "id": "screen-color-source", "text": "screen.colorDepth", "scope": "scripts", "checkScripts": true, "description": "Script references screen color depth; execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true },
      { "id": "screen-pixel-ratio-source", "text": "devicePixelRatio", "scope": "scripts", "checkScripts": true, "description": "Script references device pixel ratio; execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true }
    ]
  },
  "combinations": [
    { "id": "screen-source-profile", "name": "Script references geometry, color depth and pixel ratio", "confidence": 15, "when": { "all": [ { "any": [ { "pattern": "screen-width-source" }, { "pattern": "screen-height-source" }, { "pattern": "screen-available-source" } ] }, { "pattern": "screen-color-source" }, { "pattern": "screen-pixel-ratio-source" } ] } },
    { "id": "screen-scaled-geometry", "name": "Reads screen geometry and pixel ratio", "confidence": 25, "when": { "all": [ { "any": [ { "pattern": "screen-width" }, { "pattern": "screen-height" }, { "pattern": "screen-available" } ] }, { "pattern": "screen-pixel-ratio" } ] } },
    { "id": "screen-color-geometry", "name": "Reads screen geometry and color depth", "confidence": 35, "when": { "all": [ { "any": [ { "pattern": "screen-width" }, { "pattern": "screen-height" }, { "pattern": "screen-available" } ] }, { "pattern": "screen-color" } ] } },
    { "id": "screen-profile", "name": "Screen dimensions and color profile", "confidence": 35, "when": { "all": [ { "pattern": "screen-width" }, { "pattern": "screen-height" }, { "pattern": "screen-color" } ] } },
    { "id": "screen-display-profile", "name": "Reads screen geometry, color depth and pixel ratio", "confidence": 50, "when": { "all": [ { "any": [ { "pattern": "screen-width" }, { "pattern": "screen-height" }, { "pattern": "screen-available" } ] }, { "pattern": "screen-color" }, { "pattern": "screen-pixel-ratio" } ] } }
  ]
}
