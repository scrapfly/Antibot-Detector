{
  "id": "detect-navigator-fingerprint",
  "name": "Navigator Fingerprint",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Fingerprint",
  "difficulty": "Low",
  "lastUpdated": "2026-11-12",
  "version": "1.5.0",
  "minExtensionVersion": "2.8",
  "website": "https://developer.mozilla.org/en-US/docs/Web/API/Navigator",
  "icon": "navigator_fingerprint.png",
  "description": "Observed browser identity, language, and automation reads with graded profile evidence",
  "detection": {
    "js_hooks": [
      {
        "description": "Reads browser user agent string",
        "enabled": true,
        "confidence": 10,
        "target": "Navigator.prototype.userAgent",
        "id": "navigator-agent",
        "standalone": true
      },
      {
        "description": "Reads operating system platform",
        "enabled": true,
        "confidence": 15,
        "target": "Navigator.prototype.platform",
        "id": "navigator-platform",
        "standalone": true
      },
      {
        "description": "Reads the browser automation indicator",
        "enabled": true,
        "confidence": 20,
        "target": "Navigator.prototype.webdriver",
        "id": "navigator-automation",
        "standalone": true
      },
      {
        "description": "Reads browser product name",
        "enabled": false,
        "confidence": 5,
        "target": "Navigator.prototype.product",
        "id": "navigator-product",
        "standalone": false
      },
      {
        "description": "Reads browser language preferences",
        "enabled": true,
        "confidence": 5,
        "target": "Navigator.prototype.languages",
        "id": "navigator-languages",
        "standalone": true
      },
      {
        "description": "Requests high entropy user agent client hints (returned values unobserved)",
        "enabled": true,
        "confidence": 30,
        "target": "NavigatorUAData.prototype.getHighEntropyValues",
        "id": "navigator-hints",
        "standalone": true
      },
      {
        "description": "Queries the state of a browser permission (sites asking for notifications also do this)",
        "enabled": true,
        "confidence": 10,
        "target": "Permissions.prototype.query",
        "id": "navigator-permission-query",
        "standalone": true,
        "optional": true
      }
    ],
    "content": [
      {
        "id": "navigator-agent-script",
        "text": "navigator.userAgent",
        "scope": "scripts",
        "checkScripts": true,
        "description": "Script reference to navigator.userAgent (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false,
        "standalone": true
      },
      {
        "id": "navigator-automation-script",
        "text": "navigator.webdriver",
        "scope": "scripts",
        "checkScripts": true,
        "description": "Script reference to navigator.webdriver (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false,
        "standalone": true
      },
      {
        "id": "navigator-hints-script",
        "text": "getHighEntropyValues",
        "scope": "scripts",
        "checkScripts": true,
        "description": "Script reference to getHighEntropyValues (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false,
        "standalone": true
      }
    ]
  },
  "combinations": [
    {
      "id": "navigator-script-profile",
      "name": "Multiple navigator API references in scripts",
      "confidence": 15,
      "when": {
        "atLeast": 2,
        "of": [
          { "pattern": "navigator-agent-script" },
          { "pattern": "navigator-automation-script" },
          { "pattern": "navigator-hints-script" }
        ]
      }
    },
    {
      "id": "navigator-browser-profile",
      "name": "Browser identity and language preference reads",
      "confidence": 30,
      "when": {
        "all": [
          { "pattern": "navigator-languages" },
          { "any": [ { "pattern": "navigator-agent" }, { "pattern": "navigator-platform" } ] }
        ]
      }
    },
    {
      "id": "navigator-automation-profile",
      "name": "Automation indicator read and client hints request",
      "confidence": 50,
      "when": {
        "all": [
          { "pattern": "navigator-automation" },
          { "pattern": "navigator-hints" }
        ]
      }
    },
    {
      "id": "navigator-full-profile",
      "name": "Automation indicator, client hints, language preference, and browser identity reads",
      "confidence": 65,
      "when": {
        "all": [
          { "pattern": "navigator-automation" },
          { "pattern": "navigator-hints" },
          { "pattern": "navigator-languages" },
          { "any": [ { "pattern": "navigator-agent" }, { "pattern": "navigator-platform" } ] }
        ]
      }
    }
  ]
}
