{
  "id": "detect-timezone-fingerprint",
  "name": "Timezone/Intl Fingerprint",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Fingerprint",
  "difficulty": "Low",
  "lastUpdated": "2026-10-03",
  "version": "1.2.0",
  "minExtensionVersion": "2.8",
  "website": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl",
  "icon": "timezone_fingerprint.png",
  "description": "Timezone and internationalization API observations, also common in date formatting and locale-aware applications",
  "detection": {
    "js_hooks": [
      { "id": "timezone-resolved-options", "description": "Reads date formatter resolved options; returned fields are not observed", "enabled": true, "confidence": 20, "target": "Intl.DateTimeFormat.prototype.resolvedOptions", "standalone": true },
      { "id": "timezone-collator-compare", "description": "Accesses the locale-aware string comparison function", "enabled": true, "confidence": 5, "target": "Intl.Collator.prototype.compare", "standalone": true },
      { "id": "timezone-offset", "description": "Reads a date's timezone offset; date and returned offset are not observed", "enabled": true, "confidence": 15, "target": "Date.prototype.getTimezoneOffset", "standalone": true }
    ],
    "content": [
      { "id": "timezone-datetime-source", "text": "Intl.DateTimeFormat", "scope": "scripts", "checkScripts": true, "description": "Script reference to Intl.DateTimeFormat; execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true },
      { "id": "timezone-resolved-source", "text": "resolvedOptions", "scope": "scripts", "checkScripts": true, "description": "Script reference to resolvedOptions; formatter type, execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true },
      { "id": "timezone-offset-source", "text": "getTimezoneOffset", "scope": "scripts", "checkScripts": true, "description": "Script reference to getTimezoneOffset; execution and intent unconfirmed", "confidence": 10, "standalone": true, "textRegex": false, "textWholeWord": true, "textCaseSensitive": true }
    ]
  },
  "combinations": [
    { "id": "timezone-source-lookups", "name": "Script references date formatting and offset lookup", "confidence": 15, "when": { "all": [ { "pattern": "timezone-datetime-source" }, { "pattern": "timezone-offset-source" } ] } },
    { "id": "timezone-locale-operations", "name": "Uses a timezone-related API and locale comparison", "confidence": 25, "when": { "all": [ { "any": [ { "pattern": "timezone-resolved-options" }, { "pattern": "timezone-offset" } ] }, { "pattern": "timezone-collator-compare" } ] } },
    { "id": "timezone-dual-lookups", "name": "Reads date formatter options and date offset through related APIs", "confidence": 25, "when": { "all": [ { "pattern": "timezone-resolved-options" }, { "pattern": "timezone-offset" } ] } },
    { "id": "timezone-locale-profile", "name": "Reads formatter options and date offset with locale comparison", "confidence": 35, "when": { "all": [ { "pattern": "timezone-resolved-options" }, { "pattern": "timezone-offset" }, { "pattern": "timezone-collator-compare" } ] } }
  ]
}
