{
  "id": "detect-storage-fingerprint",
  "name": "Web Storage Fingerprint",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Fingerprint",
  "difficulty": "Low",
  "lastUpdated": "2026-10-03",
  "version": "1.2.0",
  "minExtensionVersion": "2.8",
  "website": "https://developer.mozilla.org/en-US/docs/Web/API/Web_Storage_API",
  "icon": "storage_fingerprint.png",
  "description": "Web Storage read, write and key enumeration signals. Routine application storage is common, so evidence strengths remain low and do not establish identifier persistence or fingerprinting intent.",
  "detection": {
    "js_hooks": [
      {
        "id": "js_hooks-1",
        "description": "Calls a Web Storage write; storage area, key, value and success are unknown",
        "enabled": true,
        "standalone": true,
        "confidence": 10,
        "target": "Storage.prototype.setItem"
      },
      {
        "id": "js_hooks-2",
        "description": "Calls a Web Storage read; storage area, returned value and purpose are unknown",
        "enabled": true,
        "standalone": true,
        "confidence": 10,
        "target": "Storage.prototype.getItem"
      },
      {
        "id": "js_hooks-3",
        "description": "Requests storage clearing; does not establish a capability probe or identifier reset",
        "enabled": true,
        "standalone": true,
        "confidence": 5,
        "target": "Storage.prototype.clear"
      },
      {
        "id": "hook-storage-key",
        "description": "Requests a storage key by index; count, returned key and enumeration intent are unknown",
        "enabled": true,
        "standalone": true,
        "confidence": 10,
        "target": "Storage.prototype.key"
      }
    ],
    "content": [
      {
        "id": "content-1",
        "text": "localStorage.setItem",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to localStorage.setItem; execution and purpose unconfirmed",
        "confidence": 5,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true
      },
      {
        "id": "content-2",
        "text": "sessionStorage",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to sessionStorage; execution and purpose unconfirmed",
        "confidence": 5,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true
      },
      {
        "id": "content-3",
        "text": "Storage.prototype",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to Storage.prototype; execution and purpose unconfirmed",
        "confidence": 5,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true
      },
      {
        "id": "content-local-storage-read",
        "text": "localStorage.getItem",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to localStorage.getItem; execution and purpose unconfirmed",
        "confidence": 5,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true
      },
      {
        "id": "content-local-storage-key",
        "text": "localStorage.key",
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true,
        "description": "Script reference to localStorage.key; execution and purpose unconfirmed",
        "confidence": 5,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true
      }
    ]
  },
  "combinations": [
    {
      "id": "storage-source-read-write",
      "name": "Storage read and write references",
      "confidence": 10,
      "when": { "all": [{ "pattern": "content-1" }, { "pattern": "content-local-storage-read" }] }
    },
    {
      "id": "storage-read-write",
      "name": "Storage read and write calls",
      "confidence": 15,
      "when": { "all": [{ "pattern": "js_hooks-1" }, { "pattern": "js_hooks-2" }] }
    },
    {
      "id": "storage-key-read",
      "name": "Storage key lookup and read calls",
      "confidence": 20,
      "when": { "all": [{ "pattern": "hook-storage-key" }, { "pattern": "js_hooks-2" }] }
    },
    {
      "id": "storage-key-read-write",
      "name": "Storage key lookup with reads and writes",
      "confidence": 25,
      "when": { "all": [{ "pattern": "hook-storage-key" }, { "pattern": "js_hooks-1" }, { "pattern": "js_hooks-2" }] }
    }
  ]
}
