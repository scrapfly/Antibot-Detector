{
  "id": "detect-hardware-fingerprint",
  "name": "Hardware Fingerprint",
  "author": "Scrapfly",
  "enabled": true,
  "category": "Fingerprint",
  "difficulty": "Low",
  "lastUpdated": "2026-10-03",
  "version": "1.2.0",
  "minExtensionVersion": "2.8",
  "website": "https://developer.mozilla.org/en-US/docs/Web/API/navigator/hardwareConcurrency",
  "icon": "hardware_fingerprint.png",
  "description": "Observed reads of CPU, memory, and touch capabilities with graded hardware profile evidence",
  "detection": {
    "js_hooks": [
      {
        "description": "Reads the reported logical CPU count",
        "enabled": true,
        "confidence": 20,
        "target": "Navigator.prototype.hardwareConcurrency",
        "id": "hardware-cpu",
        "standalone": true
      },
      {
        "description": "Reads the reported approximate device memory",
        "enabled": true,
        "confidence": 25,
        "target": "Navigator.prototype.deviceMemory",
        "id": "hardware-memory",
        "standalone": true
      },
      {
        "description": "Reads the maximum supported simultaneous touch points",
        "enabled": true,
        "confidence": 15,
        "target": "Navigator.prototype.maxTouchPoints",
        "id": "hardware-touch",
        "standalone": true
      }
    ],
    "content": [
      {
        "id": "hardware-cpu-script",
        "text": "hardwareConcurrency",
        "scope": "scripts",
        "checkScripts": true,
        "description": "Script reference to hardwareConcurrency (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false,
        "standalone": true
      },
      {
        "id": "hardware-memory-script",
        "text": "deviceMemory",
        "scope": "scripts",
        "checkScripts": true,
        "description": "Script reference to deviceMemory (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false,
        "standalone": true
      },
      {
        "id": "hardware-touch-script",
        "text": "maxTouchPoints",
        "scope": "scripts",
        "checkScripts": true,
        "description": "Script reference to maxTouchPoints (usage and intent unconfirmed)",
        "confidence": 10,
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": false,
        "standalone": true
      }
    ]
  },
  "combinations": [
    {
      "id": "hardware-script-profile",
      "name": "Multiple hardware capability references in scripts",
      "confidence": 15,
      "when": {
        "atLeast": 2,
        "of": [
          { "pattern": "hardware-cpu-script" },
          { "pattern": "hardware-memory-script" },
          { "pattern": "hardware-touch-script" }
        ]
      }
    },
    {
      "id": "hardware-touch-profile",
      "name": "Touch capability and compute capability reads",
      "confidence": 35,
      "when": {
        "all": [
          { "pattern": "hardware-touch" },
          { "any": [ { "pattern": "hardware-cpu" }, { "pattern": "hardware-memory" } ] }
        ]
      }
    },
    {
      "id": "hardware-profile",
      "name": "CPU and memory profile",
      "confidence": 50,
      "when": {
        "all": [ { "pattern": "hardware-cpu" }, { "pattern": "hardware-memory" } ]
      }
    },
    {
      "id": "hardware-full-profile",
      "name": "CPU, memory, and touch capability reads",
      "confidence": 65,
      "when": {
        "all": [
          { "pattern": "hardware-cpu" },
          { "pattern": "hardware-memory" },
          { "pattern": "hardware-touch" }
        ]
      }
    }
  ]
}
