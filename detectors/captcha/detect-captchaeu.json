{
  "id": "detect-captchaeu",
  "name": "Captcha.eu",
  "author": "Scrapfly",
  "enabled": true,
  "category": "CAPTCHA",
  "difficulty": "Low",
  "lastUpdated": "2026-10-07",
  "version": "1.2.1",
  "minExtensionVersion": "2.8",
  "website": "https://captcha.eu/",
  "icon": "custom.png",
  "description": "European GDPR-compliant CAPTCHA service with invisible protection and widget modes",
  "detection": {
    "url": [
      {
        "id": "captchaeu-sdk-url",
        "confidence": 50,
        "description": "Documented Captcha.eu SDK resource",
        "text": "^https://www\\.captcha\\.eu/sdk\\.js(?:[?#].*)?$",
        "textRegex": true,
        "textWholeWord": false,
        "textCaseSensitive": true,
        "textScope": "all",
        "standalone": true
      },
      {
        "id": "captchaeu-challenge-request",
        "confidence": 50,
        "description": "Challenge or validation request the KROT SDK sends to the Captcha.eu host",
        "text": "^https://www\\.captcha\\.eu/(?:challenge|validate)(?:[?#]|$)",
        "textRegex": true,
        "textWholeWord": false,
        "textCaseSensitive": true,
        "textScope": "all",
        "standalone": true
      }
    ],
    "content": [
      {
        "id": "captchaeu-krot-reference",
        "confidence": 10,
        "description": "Documented KROT SDK identifier reference in script source only",
        "text": "KROT",
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true
      }
    ],
    "dom": [
      {
        "id": "captchaeu-solution-field",
        "selector": "input[type='hidden'][name='captcha_at_solution']",
        "confidence": 40,
        "description": "Documented interceptForm hidden solution field, not proof of a solved challenge",
        "selectorRegex": false,
        "selectorWholeWord": false,
        "selectorCaseSensitive": true,
        "standalone": true
      }
    ],
    "window": [
      {
        "id": "captchaeu-krot-setup",
        "path": "KROT.setup",
        "condition": "typeof function",
        "confidence": 40,
        "description": "Documented KROT setup API presence, not execution",
        "standalone": true
      },
      {
        "id": "captchaeu-krot-get-solution",
        "path": "KROT.getSolution",
        "condition": "typeof function",
        "confidence": 40,
        "description": "Documented KROT solution API presence, not execution",
        "standalone": true
      },
      {
        "id": "captchaeu-krot-intercept-form",
        "path": "KROT.interceptForm",
        "condition": "typeof function",
        "confidence": 40,
        "description": "Documented KROT form API presence, not execution",
        "standalone": true
      }
    ]
  },
  "combinations": [
    {
      "id": "captchaeu-sdk-runtime",
      "name": "SDK resource with compatible runtime API",
      "when": { "all": [
        { "pattern": "captchaeu-sdk-url" },
        { "any": [
          { "pattern": "captchaeu-krot-setup" },
          { "pattern": "captchaeu-krot-get-solution" },
          { "pattern": "captchaeu-krot-intercept-form" }
        ] }
      ] },
      "confidence": 70
    },
    {
      "id": "captchaeu-sdk-challenge",
      "name": "SDK resource and a Captcha.eu challenge request",
      "when": { "all": [
        { "pattern": "captchaeu-sdk-url" },
        { "pattern": "captchaeu-challenge-request" }
      ] },
      "confidence": 75
    },
    {
      "id": "captchaeu-sdk-form",
      "name": "SDK resource with documented form integration markup",
      "when": { "all": [
        { "pattern": "captchaeu-sdk-url" },
        { "pattern": "captchaeu-solution-field" }
      ] },
      "confidence": 80
    },
    {
      "id": "captchaeu-sdk-form-runtime",
      "name": "SDK resource, form markup and compatible runtime API",
      "when": { "all": [
        { "pattern": "captchaeu-sdk-url" },
        { "pattern": "captchaeu-solution-field" },
        { "any": [
          { "pattern": "captchaeu-krot-setup" },
          { "pattern": "captchaeu-krot-get-solution" },
          { "pattern": "captchaeu-krot-intercept-form" }
        ] }
      ] },
      "confidence": 95
    }
  ]
}
