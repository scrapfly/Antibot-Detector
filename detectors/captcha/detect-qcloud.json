{
  "id": "detect-qcloud",
  "name": "QCloud Captcha",
  "author": "Scrapfly",
  "enabled": true,
  "category": "CAPTCHA",
  "difficulty": "Low",
  "lastUpdated": "2026-10-04",
  "version": "1.2.0",
  "minExtensionVersion": "2.8",
  "website": "https://cloud.tencent.com/product/tci",
  "icon": "custom.png",
  "description": "Tencent Cloud Captcha service for bot detection",
  "detection": {
    "url": [
      {
        "id": "qcloud-sdk",
        "confidence": 60,
        "description": "Official Tencent CAPTCHA SDK resource, including the legacy captcha.qq.com loader; not proof of execution",
        "text": "^https://(?:turing\\.captcha\\.qcloud\\.com/(?:TCaptcha|TJCaptcha)\\.js|ca\\.turing\\.captcha\\.qcloud\\.com/(?:TCaptcha-global|TJNCaptcha-global)\\.js|www\\.tycaptcha\\.com/TJNCaptcha-global\\.js|(?:ssl|t)\\.captcha\\.qq\\.com/TCaptcha\\.js)(?:[?#].*)?$",
        "textRegex": true,
        "textWholeWord": false,
        "textCaseSensitive": true,
        "textScope": "all",
        "standalone": true
      },
      {
        "id": "qcloud-prehandle",
        "confidence": 50,
        "description": "Challenge handshake the SDK sends to its own capDomain before showing a challenge",
        "text": "^https://(?:turing\\.captcha\\.qcloud\\.com|ca\\.turing\\.captcha\\.qcloud\\.com|(?:ssl|t)\\.captcha\\.qq\\.com)/cap_union_(?:prehandle|preload)(?:[?#]|$)",
        "textRegex": true,
        "textWholeWord": false,
        "textCaseSensitive": true,
        "textScope": "all",
        "standalone": true
      }
    ],
    "content": [
      {
        "id": "qcloud-constructor-reference",
        "confidence": 10,
        "description": "Script reference to TencentCaptcha, runtime presence unconfirmed",
        "text": "TencentCaptcha",
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true
      },
      {
        "id": "qcloud-sdk-reference",
        "confidence": 10,
        "description": "Script reference to Tencent SDK filenames, loading unconfirmed",
        "text": "\\b(?:TCaptcha(?:-global)?|TJCaptcha|TJNCaptcha-global)\\.js\\b",
        "textRegex": true,
        "textWholeWord": false,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true
      }
    ],
    "dom": [
      {
        "id": "qcloud-challenge-frame",
        "selector": "iframe[src='https://turing.captcha.qcloud.com/template/placeholder_v2.html'], iframe[src^='https://turing.captcha.qcloud.com/template/placeholder_v2.html?'], iframe[src='https://turing.captcha.qcloud.com/template/new_slide_placeholder.html'], iframe[src^='https://turing.captcha.qcloud.com/template/new_slide_placeholder.html?'], iframe[src='https://ca.turing.captcha.qcloud.com/template/placeholder_v2.html'], iframe[src^='https://ca.turing.captcha.qcloud.com/template/placeholder_v2.html?'], iframe[src='https://ca.turing.captcha.qcloud.com/template/new_slide_placeholder.html'], iframe[src^='https://ca.turing.captcha.qcloud.com/template/new_slide_placeholder.html?']",
        "confidence": 60,
        "description": "Tencent SDK challenge frame markup on the China or international host; visibility and verification unconfirmed",
        "selectorRegex": false,
        "selectorWholeWord": false,
        "selectorCaseSensitive": true,
        "standalone": true
      }
    ],
    "window": [
      {
        "id": "qcloud-constructor",
        "path": "TencentCaptcha",
        "condition": "typeof function",
        "confidence": 40,
        "description": "TencentCaptcha constructor presence, not an executed challenge",
        "standalone": true
      }
    ]
  },
  "combinations": [
    {
      "id": "qcloud-loaded-api",
      "name": "Official SDK and compatible constructor present",
      "when": {
        "all": [{ "pattern": "qcloud-sdk" }, { "pattern": "qcloud-constructor" }]
      },
      "confidence": 70
    },
    {
      "id": "qcloud-sdk-prehandle",
      "name": "Official SDK and its challenge handshake request",
      "when": {
        "all": [{ "pattern": "qcloud-sdk" }, { "pattern": "qcloud-prehandle" }]
      },
      "confidence": 80
    },
    {
      "id": "qcloud-sdk-frame",
      "name": "Official SDK and Tencent challenge frame markup present",
      "when": {
        "all": [{ "pattern": "qcloud-sdk" }, { "pattern": "qcloud-challenge-frame" }]
      },
      "confidence": 85
    },
    {
      "id": "qcloud-integrated-frame",
      "name": "SDK, challenge frame markup and constructor corroborate integration",
      "when": {
        "all": [{ "pattern": "qcloud-sdk" }, { "pattern": "qcloud-challenge-frame" }, { "pattern": "qcloud-constructor" }]
      },
      "confidence": 95
    }
  ]
}
