{
  "id": "detect-smartcaptcha",
  "name": "Yandex SmartCaptcha",
  "author": "Scrapfly",
  "enabled": true,
  "category": "CAPTCHA",
  "difficulty": "Medium",
  "lastUpdated": "2026-10-06",
  "version": "1.0.0",
  "minExtensionVersion": "2.8",
  "website": "https://yandex.cloud/services/smart-captcha",
  "icon": "smartcaptcha_official.png",
  "description": "Yandex Cloud SmartCaptcha with invisible and advanced (render API) modes, common on CIS-market sites",
  "detection": {
    "url": [
      {
        "id": "smartcaptcha-sdk-resource",
        "confidence": 60,
        "description": "Official SmartCaptcha widget script on Yandex Cloud's captcha host",
        "text": "^https://smartcaptcha\\.(?:yandexcloud\\.net|cloud\\.yandex\\.ru)/captcha\\.js(?:[?#]|$)",
        "textRegex": true,
        "textWholeWord": false,
        "textCaseSensitive": true,
        "textScope": "all",
        "standalone": true
      },
      {
        "id": "smartcaptcha-check-endpoint",
        "confidence": 50,
        "description": "SmartCaptcha verification request",
        "text": "^https://smartcaptcha\\.(?:yandexcloud\\.net|cloud\\.yandex\\.ru)/check\\?",
        "textRegex": true,
        "textCaseSensitive": false,
        "textScope": "all",
        "standalone": true
      }
    ],
    "content": [
      {
        "id": "smartcaptcha-script-reference",
        "confidence": 10,
        "description": "Script reference to the SmartCaptcha runtime; integration and execution unconfirmed",
        "text": "smartCaptcha",
        "textRegex": false,
        "textWholeWord": true,
        "textCaseSensitive": true,
        "scope": "scripts",
        "checkScripts": true,
        "standalone": true
      }
    ],
    "dom": [
      {
        "id": "smartcaptcha-configured-widget",
        "selector": ".smart-captcha[data-sitekey]",
        "confidence": 40,
        "description": "Documented automatic-render container with a sitekey attribute; key validity unconfirmed",
        "standalone": true
      }
    ],
    "window": [
      {
        "id": "smartcaptcha-runtime",
        "path": "smartCaptcha.render",
        "condition": "typeof function",
        "confidence": 30,
        "description": "SmartCaptcha render API (a bare config object is not enough)",
        "standalone": true
      }
    ]
  },
  "combinations": [
    {
      "id": "smartcaptcha-widget-runtime",
      "name": "Configured widget container and runtime object",
      "when": {
        "all": [
          { "pattern": "smartcaptcha-configured-widget" },
          { "pattern": "smartcaptcha-runtime" }
        ]
      },
      "confidence": 75
    },
    {
      "id": "smartcaptcha-sdk-widget",
      "name": "Official widget script and configured container",
      "when": {
        "all": [
          { "pattern": "smartcaptcha-sdk-resource" },
          { "pattern": "smartcaptcha-configured-widget" }
        ]
      },
      "confidence": 80
    },
    {
      "id": "smartcaptcha-sdk-runtime",
      "name": "Official widget script and runtime object",
      "when": {
        "all": [
          { "pattern": "smartcaptcha-sdk-resource" },
          { "pattern": "smartcaptcha-runtime" }
        ]
      },
      "confidence": 85
    },
    {
      "id": "smartcaptcha-sdk-check",
      "name": "SDK sending a verification request",
      "confidence": 90,
      "when": {
        "all": [
          { "pattern": "smartcaptcha-sdk-resource" },
          { "pattern": "smartcaptcha-check-endpoint" }
        ]
      }
    },
    {
      "id": "smartcaptcha-complete-integration",
      "name": "Official widget script, configured container and runtime object",
      "when": {
        "all": [
          { "pattern": "smartcaptcha-sdk-resource" },
          { "pattern": "smartcaptcha-configured-widget" },
          { "pattern": "smartcaptcha-runtime" }
        ]
      },
      "confidence": 95
    }
  ]
}
