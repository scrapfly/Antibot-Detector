{
  "version": "1.0.0",
  "settings": {
    "general": {
      "notificationsEnabled": true,
      "debugMode": false
    },
    "detection": {
      "cacheDuration": 12,
      "cacheUnit": "hours",
      "cacheScope": "full",
      "blacklistedDomains": [],
      "enhancedDetection": {
        "enabled": true,
        "windowPropertiesMode": "standard",
        "hooksTimeoutMs": 5000,
        "useEventDrivenChecks": false,
        "useFinalIdleCheck": false,
        "maxDetectionWindowMs": 5000,
        "keepHooksInstalled": true,
        "_comment": "FIX: JS hooks now start monitoring at document_start (not page ready) for 100% reliability. Window properties now use polling (200ms interval) until settled (3 checks with no new detections) instead of fixed retry intervals."
      }
    },
    "jsApi": {
      "enableJsApi": false
    },
    "webhook": {
      "enableWebhook": false,
      "webhookOnCache": false,
      "webhookMethod": "POST",
      "webhookUrl": "",
      "webhookContentType": "application/json",
      "webhookPayload": "{\"url\": \"<SITEURL>\", \"detections\": <DETECTIONS>, \"timestamp\": \"<TIMESTAMP>\", \"count\": <DETECTION_COUNT>}"
    },
    "history": {
      "historyLimit": 0,
      "historyBehavior": "rolling",
      "autoClearDays": 30,
      "exportFormat": "json",
      "includeTimestamps": true,
      "historyBypassCache": false
    },
    "duplicatePrevention": {
      "preventDuplicates": false,
      "duplicateScope": "full_url",
      "duplicateDuration": 1,
      "duplicateUnit": "hours"
    }
  }
}