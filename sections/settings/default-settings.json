{
  "version": "1.0.0",
  "settings": {
    "notificationsEnabled": true,
    "debugMode": false,
    "debugVerbose": false,
    "logCollectorEnabled": false,
    "logCollectorMaxLogs": 5000,

    "badgeColors": {
      "low": "#22c55e",
      "medium": "#f59e0b",
      "high": "#ef4444"
    },

    "categoryColors": {
      "antibot": "#FF5733",
      "captcha": "#33C3FF",
      "fingerprint": "#3b82f6"
    },

    "tagColors": {
      "dom": "#8D33FF",
      "headers": "#FF33A8",
      "cookies": "#FFC133",
      "content": "#33FFF3",
      "urls": "#00BCD4",
      "js_hooks": "#00E5FF",
      "window": "#4CAF50",
      "payload": "#9C27B0"
    },

    "detection": {
      "cacheDuration": 12,
      "cacheUnit": "hours",
      "cacheScope": "domain",
      "sortBy": "category",
      "categoryOrder": ["antibot", "captcha", "fingerprint"],
      "advancedToolsMinConfidence": 50,
      "blacklistedDomains": [],
      "hooksConfig": {}
    },

    "jsApi": {
      "enableJsApi": true
    },

    "webhook": {
      "enableWebhook": false,
      "webhookOnCache": false,
      "webhookMethod": "POST",
      "webhookUrl": "",
      "webhookContentType": "application/json",
      "webhookPayload": "{\"url\": \"<SITEURL>\", \"hostname\": \"<HOSTNAME>\", \"title\": \"<TITLE>\", \"favicon\": \"<FAVICON>\", \"detections\": <DETECTIONS>, \"timestamp\": \"<TIMESTAMP>\", \"count\": <DETECTION_COUNT>, \"categories\": \"<CATEGORIES>\"}",
      "webhookHeaders": []
    },

    "share": {
      "provider": "dpaste_com",
      "dpasteComDays": 30,
      "dpasteOrgExpires": "2592000",
      "pastebinKey": "",
      "pastebinExpire": "1M",
      "githubToken": "",
      "customUrl": "",
      "customMethod": "POST",
      "customBodyFormat": "form",
      "customFieldName": "content",
      "customJsonTemplate": "{\"content\": <CONTENT_JSON>, \"title\": <TITLE_JSON>, \"expiry_days\": <EXPIRY_DAYS>}",
      "customHeaders": "",
      "customLinkFrom": "body",
      "customLinkJsonPath": "url",
      "customExpiryDays": 30
    },

    "history": {
      "historyLimit": 0,
      "historyAutoDelete": false,
      "historyAutoDeleteDays": 30,
      "exportFormat": "json",
      "includeTimestamps": true,
      "historyBypassCache": false
    },

    "duplicatePrevention": {
      "preventDuplicates": false,
      "duplicateScope": "full_url",
      "duplicateDuration": 1,
      "duplicateUnit": "hours"
    },

    "updates": {
      "autoUpdate": false,
      "checkIntervalHours": 12,
      "lastCheckTimestamp": 0
    }
  }
}
